---
import Base from '../layouts/Base.astro';
---
<Base title="Thanks | Colorado Elopement Guide" description="Thanks — we've got it.">
  <div class="max-w-xl mx-auto px-4 py-20 text-center">
    <h1 class="display text-3xl text-pine-900">Got it — thank you!</h1>
    <p class="text-stone-600 mt-3">If you claimed a listing, we'll verify your email against your business domain and reply within two business days. If you signed up for the checklist, it's on the way.</p>
    <a href="/" class="inline-block mt-6 rounded-lg bg-pine-800 text-sand-50 px-5 py-2.5 text-sm">Back to the guide</a>
  </div>
</Base>
