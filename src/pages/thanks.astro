---
import Base from '../layouts/Base.astro';
---
<Base title="Thanks | Colorado Elopement Guide" description="Thanks — we've got it.">
  <div class="max-w-xl mx-auto px-5 md:px-8 py-24 text-center">
    <h1 class="display text-4xl leading-tight">Got it — <span class="serif-i">thank you</span></h1>
    <p class="text-ink/65 mt-4 leading-relaxed">If you claimed a listing, we'll verify your email against your business domain and reply within two business days. If you signed up for the checklist, it's on the way — you can also <a href="/checklist" class="underline underline-offset-4">read it right now</a>.</p>
    <a href="/" class="inline-block mt-8 rounded-full bg-ink text-ivory px-7 py-3.5 text-sm font-semibold hover:bg-spruce-800 transition-colors">Back to the guide</a>
  </div>
</Base>
