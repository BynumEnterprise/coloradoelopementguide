---
import Base from '../../layouts/Base.astro';
import EmailCapture from '../../components/EmailCapture.astro';
import { getCollection, render } from 'astro:content';
import { CATEGORIES, REGIONS } from '../../lib/taxonomy';
import { regionImg } from '../../lib/assets';

export async function getStaticPaths() {
  const resources = await getCollection('resources');
  return resources.map(r => ({ params: { slug: r.id }, props: { resource: r } }));
}

const { resource } = Astro.props;
const { slug } = Astro.params;
const data = resource.data;
const { Content, headings } = await render(resource);
const toc = headings.filter(h => h.depth === 2);

const KIND_LABEL: Record<string, string> = { permits: 'Permits', legal: 'Legal', budget: 'Budget', planning: 'Planning' };
const regions = data.regions.filter(r => r in REGIONS && r !== 'other-colorado');
const categories = data.categories.filter(c => c in CATEGORIES);
const heroImg = regionImg(data.hero in REGIONS ? data.hero : 'estes-park');

const others = (await getCollection('resources'))
  .filter(r => r.id !== slug)
  .sort((a, b) => a.data.title.localeCompare(b.data.title));

// Headline convention: text wrapped in *asterisks* renders in the italic display face.
const headlineParts = data.headline.split('*');

const pageUrl = new URL(`/resources/${slug}/`, Astro.site).href;
const ld = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: data.headline.replace(/\*/g, ''),
  description: data.description,
  datePublished: data.datePublished,
  dateModified: data.dateModified ?? data.datePublished,
  image: heroImg,
  mainEntityOfPage: { '@type': 'WebPage', '@id': pageUrl },
  author: { '@type': 'Organization', name: 'Colorado Elopement Guide', url: 'https://coloradoelopementguide.com' },
  publisher: { '@type': 'Organization', name: 'Colorado Elopement Guide', url: 'https://coloradoelopementguide.com', logo: { '@type': 'ImageObject', url: 'https://coloradoelopementguide.com/favicon.svg' } },
  citation: data.sources.map(s => s.url)
};
const crumbs = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://coloradoelopementguide.com/' },
    { '@type': 'ListItem', position: 2, name: 'Permits And Licenses', item: 'https://coloradoelopementguide.com/resources/' },
    { '@type': 'ListItem', position: 3, name: data.headline.replace(/\*/g, ''), item: pageUrl }
  ]
};
const published = new Date(data.datePublished + 'T12:00:00Z').toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
---
<Base dark={true} title={data.title} description={data.description}>
  <script is:inline type="application/ld+json" slot="head" set:html={JSON.stringify(ld)} />
  <script is:inline type="application/ld+json" slot="head" set:html={JSON.stringify(crumbs)} />

  <section class="relative min-h-[52vh] flex items-end">
    <img src={heroImg} alt={data.headline.replace(/\*/g, '')} class="absolute inset-0 w-full h-full object-cover" fetchpriority="high" />
    <div class="absolute inset-0 bg-gradient-to-t from-ink/85 via-ink/30 to-black/30"></div>
    <div class="relative z-10 max-w-7xl mx-auto px-5 md:px-8 pb-12 md:pb-16 w-full">
      <p class="eyebrow text-gold mb-3"><a href="/resources" class="hover:text-ivory">Permits And Licenses</a> · {KIND_LABEL[data.kind]}</p>
      <h1 class="display text-white text-4xl md:text-6xl leading-[1.05] max-w-3xl">
        {headlineParts.map((part, i) => i % 2 === 1 ? <span class="serif-i">{part}</span> : part)}
      </h1>
      <p class="mt-5 max-w-2xl text-white/85 text-[1.02rem] leading-relaxed">{data.dek}</p>
      <p class="mt-4 text-xs text-white/55">Published {published} · Rules and fees change. Every claim here links to the office that sets it, and that office wins if we ever disagree.</p>
    </div>
  </section>

  <section class="border-b border-hairline bg-parchment/60">
    <div class="max-w-7xl mx-auto px-5 md:px-8 py-6 grid grid-cols-2 md:grid-cols-4 gap-6 text-sm">
      {data.facts.map(f => (
        <div><p class="eyebrow text-clay-600 mb-1.5">{f.label}</p><p class="text-ink/75 leading-snug">{f.value}</p></div>
      ))}
    </div>
  </section>

  <div class="max-w-3xl mx-auto px-5 md:px-8 pt-10">
    <nav aria-label="On this page" class="flex flex-wrap gap-2 text-xs">
      {toc.map(h => <a href={`#${h.slug}`} class="rounded-full border border-hairline bg-white px-3 py-1.5 text-ink/70 hover:border-ink/40 hover:text-ink transition-colors">{h.text}</a>)}
    </nav>
  </div>

  <article class="guide-body max-w-3xl mx-auto px-5 md:px-8 pt-10">
    <Content />
  </article>

  <section class="max-w-3xl mx-auto px-5 md:px-8 pt-12">
    <p class="eyebrow text-clay-600 mb-4">Sources We Checked</p>
    <ol class="rounded-2xl border border-hairline bg-white divide-y divide-hairline text-sm">
      {data.sources.map(s => (
        <li class="px-5 py-3.5 flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
          <a href={s.url} rel="noopener nofollow" target="_blank" class="font-medium text-ink underline underline-offset-4 decoration-gold hover:text-clay-700">{s.label}</a>
          <span class="text-xs text-ink/45 break-all">{s.url.replace(/^https?:\/\/(www\.)?/, '').split('/')[0]}</span>
        </li>
      ))}
    </ol>
    <p class="mt-3 text-xs text-ink/50">Verified October 2026. If a link above says something different from this page, trust the link and <a href="/contact" class="underline underline-offset-4 hover:text-clay-700">tell us</a>.</p>
  </section>

  {(regions.length > 0 || categories.length > 0) && (
    <section class="max-w-3xl mx-auto px-5 md:px-8 pt-12">
      <p class="eyebrow text-clay-600 mb-4">Where This Applies</p>
      <div class="grid grid-cols-2 md:grid-cols-3 gap-px bg-hairline border border-hairline rounded-2xl overflow-hidden">
        {regions.map(r => (
          <a href={`/guides/${r}`} class="group bg-ivory hover:bg-parchment transition-colors p-5">
            <p class="display text-lg leading-snug group-hover:text-clay-700 transition-colors">{REGIONS[r].name}</p>
            <p class="text-xs text-ink/50 mt-1.5">Region planning guide</p>
          </a>
        ))}
        {categories.map(c => (
          <a href={`/category/${c}`} class="group bg-ivory hover:bg-parchment transition-colors p-5">
            <p class="display text-lg leading-snug group-hover:text-clay-700 transition-colors">{CATEGORIES[c].name}</p>
            <p class="text-xs text-ink/50 mt-1.5">Browse vendors</p>
          </a>
        ))}
      </div>
    </section>
  )}

  <section class="max-w-3xl mx-auto px-5 md:px-8 pt-14">
    <div class="rounded-3xl bg-spruce-900 text-ivory p-8 md:p-10 md:flex items-center justify-between gap-8">
      <div>
        <p class="eyebrow text-gold mb-3">Your Free Planner</p>
        <h2 class="display text-2xl md:text-3xl leading-tight">Keep the permit, the license dates<br class="hidden md:block" /> and <span class="serif-i">every vendor</span> in one place</h2>
        <p class="text-sm text-ivory/75 mt-3 leading-relaxed max-w-md">Heart the vendors you like as you browse, then track quotes, notes and bookings alongside the Colorado checklist. Free, synced to your email.</p>
      </div>
      <div class="mt-6 md:mt-0 shrink-0"><a href="/account" class="inline-block rounded-full bg-ivory text-ink px-7 py-3.5 text-sm font-semibold hover:bg-white transition-colors">Start My Planner</a></div>
    </div>
  </section>

  <section class="max-w-7xl mx-auto px-5 md:px-8 pt-20">
    <p class="eyebrow text-clay-600 mb-3">More Permits And Licenses</p>
    <h2 class="display text-3xl leading-tight mb-8">The rest of the <span class="serif-i">paperwork</span></h2>
    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-3 md:gap-4">
      {others.map(r => (
        <a href={`/resources/${r.id}`} class="group rounded-2xl border border-hairline bg-white p-5 hover:shadow-md transition-shadow flex flex-col">
          <p class="eyebrow text-clay-600 mb-2">{KIND_LABEL[r.data.kind]}</p>
          <p class="display text-lg leading-snug group-hover:text-clay-700 transition-colors">{r.data.headline.replace(/\*/g, '')}</p>
          <p class="text-xs text-ink/50 mt-auto pt-4">Read it →</p>
        </a>
      ))}
    </div>
  </section>

  <div class="max-w-7xl mx-auto px-5 md:px-8 pt-20"><EmailCapture /></div>
</Base>

<style is:global>
  .guide-body h2 { font-family: var(--font-display); font-weight: 400; letter-spacing: -0.01em; font-size: 1.85rem; line-height: 1.2; margin: 3rem 0 1rem; scroll-margin-top: 1.5rem; }
  .guide-body h2:first-child { margin-top: 0; }
  .guide-body h3 { font-family: var(--font-display); font-weight: 400; font-size: 1.3rem; line-height: 1.3; margin: 2rem 0 0.5rem; }
  .guide-body p { color: rgb(35 40 31 / 0.78); font-size: 1.02rem; line-height: 1.8; margin: 0 0 1.15rem; }
  .guide-body > p:first-of-type { font-size: 1.12rem; color: rgb(35 40 31 / 0.88); }
  .guide-body a { text-decoration: underline; text-underline-offset: 4px; text-decoration-color: var(--color-gold); color: var(--color-ink); }
  .guide-body a:hover { color: var(--color-clay-700); }
  .guide-body strong { color: var(--color-ink); font-weight: 600; }
  .guide-body em { font-family: var(--font-display); font-style: italic; font-size: 1.05em; }
  .guide-body ul, .guide-body ol { margin: 0 0 1.25rem 1.3rem; color: rgb(35 40 31 / 0.78); line-height: 1.7; }
  .guide-body ul { list-style: disc; }
  .guide-body ol { list-style: decimal; }
  .guide-body li { margin-bottom: 0.4rem; padding-left: 0.2rem; }
  .guide-body li::marker { color: var(--color-clay-500); }
  .guide-body blockquote { border-left: 2px solid var(--color-gold); margin: 1.5rem 0; padding: 0.25rem 0 0.25rem 1.25rem; }
  .guide-body blockquote p { font-family: var(--font-display); font-style: italic; font-size: 1.2rem; color: var(--color-ink); }
  .guide-body hr { border: 0; border-top: 1px solid var(--color-hairline); margin: 2.5rem 0; }
  .guide-body table { width: 100%; border-collapse: collapse; font-size: 0.9rem; margin: 1.5rem 0 2rem; display: block; overflow-x: auto; }
  .guide-body thead th { font-family: var(--font-body); font-size: 11px; letter-spacing: 0.18em; text-transform: uppercase; font-weight: 600; color: var(--color-clay-600); text-align: left; padding: 0.6rem 0.75rem; border-bottom: 1px solid var(--color-hairline); white-space: nowrap; }
  .guide-body tbody td { padding: 0.7rem 0.75rem; border-bottom: 1px solid var(--color-hairline); vertical-align: top; color: rgb(35 40 31 / 0.8); line-height: 1.55; min-width: 9rem; }
  .guide-body tbody td:first-child { font-family: var(--font-display); font-size: 1.05rem; color: var(--color-ink); white-space: nowrap; }
  .guide-body tbody tr:last-child td { border-bottom: 0; }
</style>
