---
import Base from '../layouts/Base.astro';
import { allVendors } from '../lib/vendors';
import { CATEGORIES, REGIONS } from '../lib/taxonomy';
import { slotLine } from '../lib/outreach';
const vendors = await allVendors();
const vlist = vendors.map(v => ({ s: v.slug, n: v.name }));
const catNames = Object.fromEntries(Object.entries(CATEGORIES).map(([k,c]) => [k, c.name]));
const regNames = Object.fromEntries(Object.entries(REGIONS).map(([k,r]) => [k, r.name]));
// Slot line templates per category and region ("999 of 3 Featured spots open for Estes Park photographers").
const slotTemplates = Object.fromEntries(Object.keys(CATEGORIES).flatMap(c => Object.keys(REGIONS).map(r => [`${c}|${r}`, slotLine(999, c, r)])));
---
<Base title="Vendor Dashboard | Colorado Elopement Guide" description="Manage your free listing: update your details and see how many couples click through to you." noindex={true}>
  <div class="max-w-5xl mx-auto px-5 md:px-8 pt-12 pb-4">
    <div id="vd-loading" class="py-24 text-center text-ink/50">Opening your dashboard…</div>

    <!-- AUTH -->
    <div id="vd-auth" class="hidden">
      <p class="eyebrow text-clay-600 mb-3">For Colorado Vendors</p>
      <h1 class="display text-4xl md:text-5xl leading-tight">Your listing, <span class="serif-i">your numbers</span></h1>
      <p class="text-ink/65 mt-4 leading-relaxed max-w-2xl">Create a free vendor account to manage your listing and see exactly how many couples view your page, click through to your site, and tap your phone number. Real counts, bot filtered, never inflated.</p>
      <div class="mt-7 rounded-3xl border border-hairline bg-white p-6 md:p-7 max-w-md">
        <div class="flex gap-1.5 mb-5">
          <button data-vamode="signup" class="vam-btn flex-1 rounded-full px-4 py-2.5 text-sm font-medium">Create Account</button>
          <button data-vamode="signin" class="vam-btn flex-1 rounded-full px-4 py-2.5 text-sm font-medium">Sign In</button>
        </div>
        <div class="space-y-4">
          <div id="va-vendor-wrap"><label class="eyebrow text-ink/60 block mb-2">Your Business</label>
            <select id="va-vendor" class="w-full rounded-xl border border-hairline bg-ivory px-4 py-3 text-sm"><option value="">Select your listing…</option></select></div>
          <div><label class="eyebrow text-ink/60 block mb-2">Business Email</label>
            <input id="va-email" type="email" required class="w-full rounded-xl border border-hairline bg-ivory px-4 py-3 text-sm" placeholder="you@yourbusiness.com" />
            <p id="va-domhint" class="text-xs text-ink/40 mt-2 hidden">Use an email at your business domain and you're verified instantly.</p></div>
          <div><label class="eyebrow text-ink/60 block mb-2">Password</label>
            <input id="va-pass" type="password" minlength="8" required class="w-full rounded-xl border border-hairline bg-ivory px-4 py-3 text-sm" placeholder="8+ characters" /></div>
          <p id="va-err" class="hidden text-sm rounded-xl border border-clay-500 bg-clay-50 text-clay-700 px-4 py-3"></p>
          <button id="va-submit" class="w-full rounded-full bg-ink text-ivory px-7 py-3.5 text-sm font-semibold hover:bg-spruce-800 transition-colors">Create My Vendor Account</button>
        </div>
      </div>
    </div>

    <!-- DASHBOARD -->
    <div id="vd-app" class="hidden">
      <div class="md:flex items-start justify-between gap-6">
        <div>
          <p class="eyebrow text-clay-600 mb-2">Vendor Dashboard</p>
          <h1 class="display text-3xl md:text-4xl leading-tight" id="vd-name"></h1>
          <p class="text-sm text-ink/55 mt-2" id="vd-meta"></p>
        </div>
        <div class="mt-4 md:mt-0 flex gap-2.5 text-sm shrink-0">
          <a id="vd-view" href="#" class="rounded-full border border-ink/60 px-5 py-2.5 font-medium hover:bg-parchment">View My Listing</a>
          <button id="vd-signout" class="rounded-full border border-hairline px-5 py-2.5 text-ink/60 hover:bg-parchment">Sign Out</button>
        </div>
      </div>
      <div id="vd-pending" class="hidden mt-6 rounded-2xl border border-gold/60 bg-gold/10 px-5 py-4 text-sm">Your account is pending verification because your email domain doesn't match your listing's website. We review these within one business day; editing unlocks after that. Your stats are live below.</div>
      <div id="vd-setpw" class="hidden mt-6 rounded-2xl border border-spruce-800/25 bg-parchment px-5 py-4">
        <p class="text-sm font-semibold mb-1">Set a password</p>
        <p class="text-sm text-ink/60 mb-3">You signed in from your email link. Add a password so you can sign in from any device next time.</p>
        <div class="flex flex-wrap items-center gap-2.5">
          <input id="sp-pass" type="password" minlength="8" class="rounded-xl border border-hairline bg-white px-4 py-2.5 text-sm" placeholder="8+ characters" />
          <button id="sp-save" class="rounded-full bg-ink text-ivory px-6 py-2.5 text-sm font-semibold hover:bg-spruce-800">Save Password</button>
          <span id="sp-msg" class="text-sm text-ink/50"></span>
        </div>
      </div>

      <!-- TRAFFIC -->
      <p class="eyebrow text-clay-600 mt-10 mb-4">Your Traffic</p>
      <div id="vd-traffic"></div>

      <!-- INQUIRIES -->
      <p class="eyebrow text-clay-600 mt-10 mb-4">Inquiries</p>
      <div id="vd-inq" class="rounded-3xl border border-hairline bg-white p-5 md:p-6 text-sm text-ink/55">Loading inquiries…</div>

      <div class="md:grid md:grid-cols-5 gap-6 mt-10">
        <div class="md:col-span-3">
          <p class="eyebrow text-clay-600 mb-4">Your Listing</p>
          <div class="rounded-3xl border border-hairline bg-white p-6 space-y-4" id="vd-editor">
            <div><label class="eyebrow text-ink/60 block mb-2">Description</label>
              <textarea id="ve-desc" rows="5" class="w-full rounded-xl border border-hairline bg-ivory px-4 py-3 text-sm"></textarea>
              <p class="text-xs text-ink/40 mt-1.5"><span id="ve-desc-count">0</span> characters. 220 or more reads best and helps your page show up in search.</p></div>
            <div class="grid md:grid-cols-2 gap-4">
              <div><label class="eyebrow text-ink/60 block mb-2">Phone</label>
                <input id="ve-phone" class="w-full rounded-xl border border-hairline bg-ivory px-4 py-3 text-sm" /></div>
              <div><label class="eyebrow text-ink/60 block mb-2">Website</label>
                <input id="ve-web" class="w-full rounded-xl border border-hairline bg-ivory px-4 py-3 text-sm" placeholder="https://…" /></div>
            </div>
            <div class="flex items-center gap-4">
              <button id="ve-save" class="rounded-full bg-ink text-ivory px-7 py-3 text-sm font-semibold hover:bg-spruce-800">Save Changes</button>
              <span id="ve-msg" class="text-sm text-ink/40"></span>
            </div>
            <p class="text-xs text-ink/40">Changes go live on the site within a few minutes.</p>
          </div>
        </div>
        <div class="md:col-span-2 mt-8 md:mt-0">
          <p class="eyebrow text-clay-600 mb-4">Get Seen First</p>
          <div class="rounded-3xl border-2 border-clay-500 bg-white p-6">
            <p class="display text-2xl">Featured<span class="serif-i"> placement</span></p>
            <p class="display text-3xl mt-2">$40<span class="text-base text-ink/40"> / month</span></p>
            <ul class="mt-4 space-y-2 text-sm text-ink/75">
              <li>✓ Top of your category and region pages, always labeled</li>
              <li>✓ Homepage rotation</li>
              <li>✓ Cancel anytime, no contract</li>
            </ul>
            <div id="vd-founding" class="hidden mt-4 rounded-2xl bg-parchment/70 border border-hairline px-4 py-3">
              <p class="eyebrow text-clay-600">Founding Featured</p>
              <p class="text-sm text-ink/80 mt-1 leading-relaxed">The first 10 Featured vendors keep $40 a month for as long as they stay subscribed. <span id="vd-founding-line" class="font-semibold text-ink"></span>.</p>
            </div>
            <p id="vd-slot" class="hidden mt-4 text-sm font-medium text-spruce-800"></p>
            <button id="vd-wait" type="button" class="hidden mt-5 rounded-full border border-ink/60 px-6 py-3 text-sm font-semibold hover:bg-parchment">Join the Waitlist</button>
            <p id="vd-wait-msg" class="mt-2 text-xs text-ink/55"></p>
            <a id="vd-buy" href="https://buy.stripe.com/7sYaEZffj1AaaWr93A9oc02" rel="noopener" class="inline-block mt-5 rounded-full bg-clay-500 text-ivory px-6 py-3 text-sm font-semibold hover:bg-clay-600 transition-colors">Go Featured, First Month $1 →</a>
            <p class="mt-3 text-xs text-ink/50">Use code <strong>FIRSTMONTH1</strong> at checkout.</p>
          </div>

          <!-- BADGE -->
          <div id="vd-badge" class="hidden mt-8">
            <p class="eyebrow text-clay-600 mb-4">Put Our Badge On Your Site</p>
            <div class="rounded-3xl border border-hairline bg-white p-6">
              <div class="flex items-center gap-4">
                <img src="/badge/listed.svg" alt="Listed on Colorado Elopement Guide" width="180" height="60" class="shrink-0" />
                <p class="text-sm text-ink/70 leading-relaxed">A small badge that links back to your listing. Couples who see it on your site can read your reviews and reach you here, and the link helps your listing rank.</p>
              </div>
              <label class="eyebrow text-ink/60 block mt-5 mb-2">Paste This Into Your Website</label>
              <textarea id="vd-badge-code" readonly rows="3" class="w-full rounded-xl border border-hairline bg-ivory px-4 py-3 text-xs font-mono text-ink/80" spellcheck="false"></textarea>
              <div class="flex items-center gap-4 mt-3">
                <button id="vd-badge-copy" type="button" class="rounded-full bg-ink text-ivory px-6 py-2.5 text-sm font-semibold hover:bg-spruce-800">Copy Code</button>
                <span id="vd-badge-msg" class="text-sm text-ink/50"></span>
              </div>
              <p class="mt-3 text-xs text-ink/45">Works in Squarespace, Wix, WordPress and Showit code blocks. Footers and About pages are the usual spots.</p>
            </div>
          </div>
        </div>
      </div>

      <!-- PHOTOS -->
      <p class="eyebrow text-clay-600 mt-10 mb-4">Photos</p>
      <div id="vd-photos" class="rounded-3xl border border-hairline bg-white p-6 md:p-7">
        <div id="ph-locked" class="hidden text-sm text-ink/60">Photo uploads unlock once your account is verified. You will then be able to add a cover photo and up to six gallery photos.</div>
        <div id="ph-open" class="hidden">
          <div class="md:flex items-start justify-between gap-6">
            <div>
              <p class="display text-2xl">Your <span class="serif-i">photos</span></p>
              <p class="text-sm text-ink/60 mt-1 leading-relaxed max-w-xl">Add a cover photo and up to six gallery photos. Couples see them on your listing. Large photos are resized in your browser before they upload.</p>
            </div>
            <p id="ph-count" class="text-xs text-ink/50 mt-2 md:mt-1 shrink-0"></p>
          </div>
          <label id="ph-drop" for="ph-file" class="mt-5 flex flex-col items-center justify-center gap-2 rounded-2xl border-2 border-dashed border-hairline bg-ivory px-6 py-8 text-center cursor-pointer hover:bg-parchment/60 transition-colors">
            <span class="text-sm font-medium">Drag Photos Here</span>
            <span class="text-xs text-ink/50">or</span>
            <span class="rounded-full bg-ink text-ivory px-6 py-2.5 text-sm font-semibold">Choose Photos</span>
            <span class="text-xs text-ink/45 mt-1">JPEG, PNG or WebP</span>
            <input id="ph-file" type="file" accept="image/jpeg,image/png,image/webp" multiple class="sr-only" />
          </label>
          <p class="text-xs text-ink/50 mt-3">Only upload photos you own or have permission to use.</p>
          <p id="ph-msg" class="text-sm text-ink/60 mt-3 min-h-[1.25rem]" aria-live="polite"></p>
          <div id="ph-grid" class="mt-3 grid grid-cols-2 sm:grid-cols-3 gap-4"></div>
        </div>
      </div>
    </div>
  </div>

  <script is:inline define:vars={{ vlist, catNames, regNames, slotTemplates }}>
    const SB = 'https://yucgsuzveabsgntlmste.supabase.co/rest/v1/rpc/';
    const SBK = 'sb_publishable_acsHsb9mrZ756aT12EgAPQ_GugWXmjM';
    const rpc = (fn, args) => fetch(SB + fn, { method:'POST', headers:{ apikey:SBK, Authorization:'Bearer '+SBK, 'Content-Type':'application/json' }, body: JSON.stringify(args) }).then(r => r.ok ? r.json() : null).catch(()=>null);
    const vtok = () => localStorage.getItem('ceg_vtoken');
    const esc = s => String(s ?? '').replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
    const num = n => Number(n || 0).toLocaleString('en-US');
    const fmtDay = d => new Date(d + 'T12:00:00').toLocaleDateString('en-US', { month:'short', day:'numeric' });
    let mode='signup', VD=null, SERIES=[];
    function show(which){ for (const id of ['loading','auth','app']) document.getElementById('vd-'+id).classList.toggle('hidden', id!==which); }
    function paintMode(){
      document.querySelectorAll('.vam-btn').forEach(b=>{
        const on=b.dataset.vamode===mode;
        b.className='vam-btn flex-1 rounded-full px-4 py-2.5 text-sm font-medium '+(on?'bg-ink text-ivory':'bg-parchment text-ink/60 hover:bg-hairline/60');
      });
      document.getElementById('va-vendor-wrap').classList.toggle('hidden', mode!=='signup');
      document.getElementById('va-domhint').classList.toggle('hidden', mode!=='signup');
      document.getElementById('va-submit').textContent = mode==='signup' ? 'Create My Vendor Account' : 'Sign In';
    }
    async function boot(){
      const sel=document.getElementById('va-vendor');
      vlist.sort((a,b)=>a.n.localeCompare(b.n)).forEach(v=>{ const o=document.createElement('option'); o.value=v.s; o.textContent=v.n; sel.appendChild(o); });
      const qp=new URLSearchParams(location.search);
      const magic=qp.get('t');
      if(magic){ localStorage.setItem('ceg_vtoken', magic); history.replaceState(null,'',location.pathname); }
      const pre=qp.get('vendor'); if(pre) sel.value=pre;
      if (!vtok()) { show('auth'); paintMode(); return; }
      VD = await rpc('ceg_vendor_get', { p_token: vtok() });
      if (!VD) { localStorage.removeItem('ceg_vtoken'); show('auth'); paintMode(); return; }
      paint(); show('app'); drawChart(); loadExtras(); loadPhotos();
    }

    // ---------- inquiries and Featured slots ----------
    const fmtWhen = d => d ? new Date(String(d).length <= 10 ? d + 'T12:00:00' : d).toLocaleDateString('en-US', { month:'short', day:'numeric', year:'numeric' }) : '';
    async function loadExtras(){
      const v = VD.vendor;
      const box = document.getElementById('vd-inq');
      const inq = await rpc('ceg_vendor_inquiries', { p_token: vtok() });
      if (!inq) { box.textContent = 'Could not load inquiries right now.'; }
      else if (!inq.verified) {
        box.innerHTML = `<p class="text-ink/75"><span class="display text-3xl text-ink">${num(inq.count)}</span> ${inq.count === 1 ? 'inquiry' : 'inquiries'} from couples so far.</p><p class="mt-2">You can read and answer them as soon as your account is verified.</p>`;
      } else if (!inq.items.length) {
        box.innerHTML = '<p>No inquiries yet. When a couple uses Check Availability on your listing, their note shows up here and in your email.</p>';
      } else {
        box.innerHTML = `<p class="text-xs text-ink/50 mb-3">${num(inq.count)} ${inq.count === 1 ? 'inquiry' : 'inquiries'}. Reply goes straight to the couple.</p><ul>` + inq.items.map(i => {
          const subj = encodeURIComponent('Re: your inquiry to ' + v.name);
          const meta = [fmtWhen(i.created_at), i.wedding_date ? 'Wedding ' + fmtWhen(i.wedding_date) : null, i.guests ? num(i.guests) + ' guests' : null].filter(Boolean).join(' · ');
          return `<li class="py-4 border-b border-hairline last:border-0">
            <div class="flex flex-wrap items-baseline justify-between gap-3"><p class="font-semibold text-ink">${esc(i.names)}</p><a href="mailto:${esc(i.email)}?subject=${subj}" class="rounded-full bg-ink text-ivory px-5 py-2 text-xs font-semibold hover:bg-spruce-800">Reply</a></div>
            <p class="text-xs text-ink/50 mt-1">${esc(meta)} · ${esc(i.email)}</p>
            <p class="mt-2 text-ink/80 whitespace-pre-line leading-relaxed">${esc(i.message)}</p></li>`;
        }).join('') + '</ul>';
      }
      const slot = document.getElementById('vd-slot');
      if (v.status === 'featured') { slot.textContent = 'You are Featured' + (v.featured_until ? ' through ' + fmtWhen(v.featured_until) : '') + '.'; slot.classList.remove('hidden'); document.getElementById('vd-buy').classList.add('hidden'); return; }
      rpc('ceg_public_stats', {}).then(st => {
        if (!st || typeof st.founding_left !== 'number' || st.founding_left <= 0) return;
        document.getElementById('vd-founding-line').textContent = st.founding_left + ' of 10 founding spots left';
        document.getElementById('vd-founding').classList.remove('hidden');
      });
      const s = await rpc('ceg_featured_slots', { p_category: v.category, p_sub_region: v.sub_region });
      if (!s) return;
      const tpl = slotTemplates[v.category + '|' + v.sub_region];
      if (tpl) { slot.textContent = tpl.replace('999', String(s.open)); slot.classList.remove('hidden'); }
      if (s.open <= 0) { document.getElementById('vd-buy').classList.add('hidden'); document.getElementById('vd-wait').classList.remove('hidden'); }
    }

    // ---------- photos: upload, cover, order, delete ----------
    let PHOTOS = [], PH_MAX = 6, phBusy = false;
    const phMsg = t => { const el = document.getElementById('ph-msg'); if (el) el.textContent = t || ''; };
    async function phApi(body){
      try {
        const isForm = body instanceof FormData;
        const r = await fetch('/api/vendor-photo', { method:'POST', headers: isForm ? {} : { 'Content-Type':'application/json' }, body: isForm ? body : JSON.stringify(body) });
        const j = await r.json().catch(() => null);
        return j || { ok:false, error: r.status === 413 ? 'That photo is too large.' : 'Something went wrong. Please try again.' };
      } catch(_) { return { ok:false, error:'Could not reach the server. Check your connection and try again.' }; }
    }
    // Rebuild the static site at most once every 2 minutes; later changes ride on a timer.
    let rebuildTimer = null;
    function scheduleRebuild(){
      const KEY = 'ceg_vphoto_rebuild', GAP = 120000;
      const fire = () => { rebuildTimer = null; localStorage.setItem(KEY, String(Date.now())); try{ fetch('/api/refresh-site',{method:'POST'}); }catch(_){} };
      if (rebuildTimer) return;
      const wait = GAP - (Date.now() - Number(localStorage.getItem(KEY) || 0));
      if (wait <= 0) fire(); else rebuildTimer = setTimeout(fire, wait);
    }
    async function loadPhotos(){
      const verified = !!(VD && VD.verified);
      document.getElementById('ph-locked').classList.toggle('hidden', verified);
      document.getElementById('ph-open').classList.toggle('hidden', !verified);
      if (!verified) return;
      const r = await phApi({ p_token: vtok(), action: 'list' });
      if (!r.ok) { phMsg(r.error); return; }
      PHOTOS = r.photos || []; PH_MAX = r.max_gallery || 6; paintPhotos();
    }
    function paintPhotos(){
      const gallery = PHOTOS.filter(p => !p.is_cover).length, hasCover = PHOTOS.some(p => p.is_cover);
      document.getElementById('ph-count').textContent = `${gallery} of ${PH_MAX} gallery photos${hasCover ? ', plus your cover' : ', no cover chosen yet'}`;
      const full = gallery >= PH_MAX;
      document.getElementById('ph-drop').classList.toggle('opacity-50', full);
      document.getElementById('ph-file').disabled = full;
      const grid = document.getElementById('ph-grid');
      if (!PHOTOS.length) { grid.innerHTML = '<p class="col-span-full text-sm text-ink/50">No photos yet. Your listing shows its current photo until you choose a cover here.</p>'; return; }
      const btn = 'rounded-full border border-hairline px-3 py-1.5 text-xs font-medium hover:bg-parchment disabled:opacity-40 disabled:cursor-not-allowed';
      grid.innerHTML = PHOTOS.map((p, i) => `
        <figure class="rounded-2xl border ${p.is_cover ? 'border-clay-500' : 'border-hairline'} overflow-hidden bg-ivory">
          <div class="relative aspect-[4/3] bg-parchment"><img src="${esc(p.url)}" alt="Photo ${i + 1}" loading="lazy" class="absolute inset-0 w-full h-full object-cover" />
            ${p.is_cover ? '<span class="absolute top-2 left-2 eyebrow bg-clay-500 text-ivory rounded-full px-2.5 py-1">Cover</span>' : ''}</div>
          <figcaption class="p-3 flex flex-wrap gap-1.5">
            ${p.is_cover ? '' : `<button type="button" data-ph="set_cover" data-id="${p.id}" class="${btn}">Set As Cover</button>`}
            <button type="button" data-ph="up" data-id="${p.id}" class="${btn}" ${i === 0 ? 'disabled' : ''} aria-label="Move photo ${i + 1} up">Move Up</button>
            <button type="button" data-ph="down" data-id="${p.id}" class="${btn}" ${i === PHOTOS.length - 1 ? 'disabled' : ''} aria-label="Move photo ${i + 1} down">Move Down</button>
            <button type="button" data-ph="delete" data-id="${p.id}" class="${btn} text-clay-700">Delete</button>
          </figcaption>
        </figure>`).join('');
    }
    function phDone(r, okText){
      if (!r.ok) { phMsg(r.error || 'Something went wrong. Please try again.'); return false; }
      PHOTOS = r.photos || []; paintPhotos(); scheduleRebuild();
      phMsg(okText + ' Live on your page in a few minutes.');
      return true;
    }
    // Downscale to 2000px on the longest edge and re-encode as JPEG 0.85 before upload.
    async function shrink(file){
      let src;
      try { src = await createImageBitmap(file, { imageOrientation: 'from-image' }); }
      catch(_) { src = await new Promise((res, rej) => { const im = new Image(); im.onload = () => res(im); im.onerror = rej; im.src = URL.createObjectURL(file); }); }
      const w0 = src.width || src.naturalWidth, h0 = src.height || src.naturalHeight;
      const k = Math.min(1, 2000 / Math.max(w0, h0));
      const c = document.createElement('canvas'); c.width = Math.round(w0 * k); c.height = Math.round(h0 * k);
      const ctx = c.getContext('2d'); ctx.fillStyle = '#fff'; ctx.fillRect(0, 0, c.width, c.height); ctx.drawImage(src, 0, 0, c.width, c.height);
      return await new Promise(res => c.toBlob(res, 'image/jpeg', 0.85));
    }
    async function uploadFiles(files){
      if (phBusy) return;
      const list = Array.from(files || []).filter(Boolean);
      if (!list.length) return;
      phBusy = true; let ok = 0;
      try {
        for (let i = 0; i < list.length; i++) {
          const f = list[i];
          if (!/^image\/(jpeg|png|webp)$/.test(f.type)) { phMsg(`${f.name} is not a JPEG, PNG or WebP photo.`); continue; }
          if (PHOTOS.filter(p => !p.is_cover).length >= PH_MAX) { phMsg(`Your gallery is full (${PH_MAX} photos plus a cover). Delete one to add another.`); break; }
          phMsg(`Uploading ${i + 1} of ${list.length}…`);
          let blob;
          try { blob = await shrink(f); } catch(_) { blob = null; }
          if (!blob) { if (f.size > 4 * 1024 * 1024) { phMsg(`Could not resize ${f.name}. Try a smaller photo.`); continue; } blob = f; }
          const fd = new FormData(); fd.append('p_token', vtok()); fd.append('action', 'upload'); fd.append('file', blob, 'photo.jpg');
          const r = await phApi(fd);
          if (!r.ok) { phMsg(r.error); break; }
          PHOTOS = r.photos || []; paintPhotos(); ok++;
        }
        if (ok) { scheduleRebuild(); phMsg(`${ok} ${ok === 1 ? 'photo' : 'photos'} added. Live on your page in a few minutes.`); }
      } finally { phBusy = false; document.getElementById('ph-file').value = ''; }
    }
    document.addEventListener('change', e => { if (e.target.id === 'ph-file') uploadFiles(e.target.files); });
    ['dragenter','dragover'].forEach(t => document.addEventListener(t, e => { const d = e.target.closest && e.target.closest('#ph-drop'); if (d) { e.preventDefault(); d.classList.add('bg-parchment'); } }));
    ['dragleave','drop'].forEach(t => document.addEventListener(t, e => { const d = e.target.closest && e.target.closest('#ph-drop'); if (d) { e.preventDefault(); d.classList.remove('bg-parchment'); if (t === 'drop' && !document.getElementById('ph-file').disabled) uploadFiles(e.dataTransfer.files); } }));
    document.addEventListener('click', async e => {
      const b = e.target.closest('[data-ph]'); if (!b || phBusy) return;
      const id = Number(b.dataset.id), act = b.dataset.ph;
      if (act === 'delete' && !b.dataset.armed) { b.dataset.armed = '1'; b.textContent = 'Confirm Delete'; setTimeout(() => { if (b.isConnected) { delete b.dataset.armed; b.textContent = 'Delete'; } }, 4000); return; }
      phBusy = true;
      try {
        if (act === 'set_cover') { phMsg('Saving…'); phDone(await phApi({ p_token: vtok(), action: 'set_cover', photo_id: id }), 'Cover updated.'); }
        else if (act === 'delete') { phMsg('Deleting…'); phDone(await phApi({ p_token: vtok(), action: 'delete', photo_id: id }), 'Photo deleted.'); }
        else {
          const ids = PHOTOS.map(p => p.id), i = ids.indexOf(id), j = act === 'up' ? i - 1 : i + 1;
          if (i < 0 || j < 0 || j >= ids.length) return;
          [ids[i], ids[j]] = [ids[j], ids[i]];
          phMsg('Saving order…'); phDone(await phApi({ p_token: vtok(), action: 'reorder', ids }), 'Order saved.');
        }
      } finally { phBusy = false; }
    });

    // ---------- inline SVG chart: bars for views, thin lines for site clicks and phone taps ----------
    function niceStep(max){ const raw = max / 4; const p = Math.pow(10, Math.floor(Math.log10(raw))); const m = raw / p; const f = m <= 1 ? 1 : m <= 2 ? 2 : m <= 5 ? 5 : 10; return Math.max(1, f * p); }
    function drawChart(){
      const el = document.getElementById('vd-chart'); if (!el || !SERIES.length) return;
      const W = Math.max(300, el.clientWidth || 800), H = 220, n = SERIES.length;
      const pl = 34, pr = 8, pt = 12, pb = 26, iw = W - pl - pr, ih = H - pt - pb;
      const max = Math.max(1, ...SERIES.map(p => Math.max(p.views || 0, p.site || 0, p.phone || 0)));
      const step = niceStep(max), ymax = Math.ceil(max / step) * step;
      const x = i => pl + (i + 0.5) * iw / n, y = v => pt + ih - (v / ymax) * ih, bw = Math.max(2, (iw / n) * 0.62);
      let s = `<svg viewBox="0 0 ${W} ${H}" width="${W}" height="${H}" class="block w-full h-auto" role="img" aria-label="Profile views per day for the last 30 days, with site clicks and phone taps">`;
      for (let v = 0; v <= ymax; v += step) s += `<line x1="${pl}" x2="${W - pr}" y1="${y(v)}" y2="${y(v)}" stroke="#E7E1D5"/><text x="${pl - 6}" y="${y(v) + 3.5}" text-anchor="end" font-size="10" fill="#23281F" fill-opacity=".5">${num(v)}</text>`;
      SERIES.forEach((p, i) => { const v = p.views || 0; if (!v) return; s += `<rect x="${(x(i) - bw / 2).toFixed(1)}" y="${y(v).toFixed(1)}" width="${bw.toFixed(1)}" height="${(pt + ih - y(v)).toFixed(1)}" fill="#3A4A3C" fill-opacity=".85" rx="1"><title>${fmtDay(p.d)}: ${num(v)} views, ${num(p.site)} site clicks, ${num(p.phone)} phone taps</title></rect>`; });
      const line = (key, color, label) => { const pts = SERIES.map((p, i) => `${x(i).toFixed(1)},${y(p[key] || 0).toFixed(1)}`).join(' '); return `<polyline points="${pts}" fill="none" stroke="${color}" stroke-width="1.5" stroke-linejoin="round" stroke-linecap="round"/>` + SERIES.map((p, i) => (p[key] || 0) > 0 ? `<circle cx="${x(i).toFixed(1)}" cy="${y(p[key]).toFixed(1)}" r="2.5" fill="${color}"><title>${fmtDay(p.d)}: ${num(p[key])} ${label}</title></circle>` : '').join(''); };
      s += line('site', '#A9694A', 'site clicks') + line('phone', '#C99B5F', 'phone taps');
      const k = W < 480 ? 7 : 5;
      SERIES.forEach((p, i) => { if ((n - 1 - i) % k === 0) s += `<text x="${x(i).toFixed(1)}" y="${H - 8}" text-anchor="middle" font-size="10" fill="#23281F" fill-opacity=".55">${fmtDay(p.d)}</text>`; });
      if (!SERIES.some(p => (p.views || 0) + (p.site || 0) + (p.phone || 0) > 0)) s += `<text x="${(W / 2).toFixed(1)}" y="${(pt + ih / 2).toFixed(1)}" text-anchor="middle" font-size="12" fill="#23281F" fill-opacity=".5">No visits recorded in the last 30 days yet.</text>`;
      el.innerHTML = s + '</svg>';
    }
    let rsz = null; window.addEventListener('resize', () => { clearTimeout(rsz); rsz = setTimeout(drawChart, 150); });

    const SOURCE_HOSTS = [[/(^|\.)google\./,'Google'],[/(^|\.)pinterest\./,'Pinterest'],[/(^|\.)bing\.com$/,'Bing'],[/(^|\.)duckduckgo\.com$/,'DuckDuckGo'],[/(^|\.)facebook\.com$/,'Facebook'],[/(^|\.)instagram\.com$/,'Instagram'],[/^t\.co$/,'X (Twitter)'],[/(^|\.)reddit\.com$/,'Reddit'],[/(^|\.)yahoo\./,'Yahoo'],[/(^|\.)theknot\.com$/,'The Knot'],[/(^|\.)zola\.com$/,'Zola'],[/(^|\.)chatgpt\.com$/,'ChatGPT'],[/(^|\.)perplexity\.ai$/,'Perplexity']];
    function sourceLabel(s){
      if (!s || s === 'direct') return 'Direct (typed your link, bookmarked it, or came from an app)';
      if (s.startsWith('ceg:')) {
        const p = s.slice(4);
        if (p === '/vendor-dashboard') return 'This dashboard (your own visits)';
        if (p === '/' || p === '') return 'Our homepage';
        let m = p.match(/^\/category\/([^/]+)/); if (m) return `Our ${catNames[m[1]] || m[1]} page`;
        m = p.match(/^\/region\/([^/]+)/); if (m) return `Our ${regNames[m[1]] || m[1]} page`;
        if (p.startsWith('/vendors')) return 'Our All Vendors page';
        if (p.startsWith('/guides')) return 'Our planning guides';
        if (p.startsWith('/vendor/')) return 'Another vendor page on our site';
        if (p.startsWith('/my-vendors') || p.startsWith('/account')) return 'A couple’s planner';
        return 'Our site, ' + p;
      }
      for (const [re, l] of SOURCE_HOSTS) if (re.test(s)) return l;
      return esc(s);
    }

    function paint(){
      const v=VD.vendor, s=VD.stats||{};
      const t = VD.totals || { views_7d: 0, views_30d: s.views_30d, views_all: s.views_total, site_30d: s.site_clicks_30d, phone_30d: s.phone_clicks_30d, inquiries_total: s.inquiries_total };
      const b = VD.benchmark || {};
      const c = Object.assign({ has_photo: !!v.image_url, has_phone: !!v.phone, has_website: !!v.website, description_chars: (v.description || '').length, description_ok: (v.description || '').length >= 220 }, VD.completeness || {});
      SERIES = VD.series || [];
      document.getElementById('vd-name').textContent = v.name;
      document.getElementById('vd-meta').textContent = `${catNames[v.category]||''} · ${regNames[v.sub_region]||''} · signed in as ${VD.email}`;
      document.getElementById('vd-view').href = '/vendor/' + v.slug;
      document.getElementById('vd-pending').classList.toggle('hidden', VD.verified);
      document.getElementById('vd-setpw').classList.toggle('hidden', !!VD.has_password);

      const catLabel = catNames[v.category] || v.category || '';
      const avg = Number(b.category_avg_views_30d || 0);
      const bench = b.category_count ? `Average for ${esc(catLabel)} listings: ${avg % 1 === 0 ? num(avg) : avg.toFixed(1)}; you are #${num(b.category_rank_30d)} of ${num(b.category_count)}` : 'No category benchmark yet.';
      const cards = [['Views 7 Days', t.views_7d], ['Views 30 Days', t.views_30d], ['All Time Views', t.views_all]];
      const refs = VD.referrers || [];
      const refMax = Math.max(1, ...refs.map(r => r.n || 0));
      const refList = refs.length ? refs.map(r => `<li class="py-2 border-b border-hairline last:border-0"><div class="flex items-center justify-between gap-3 text-sm"><span>${sourceLabel(r.source)}</span><span class="text-ink/60 tabular-nums shrink-0">${num(r.n)}</span></div><div class="mt-1.5 h-1 rounded-full bg-parchment overflow-hidden"><div class="h-full bg-spruce-700" style="width:${Math.round(100 * (r.n || 0) / refMax)}%"></div></div></li>`).join('')
        : '<li class="py-3 text-sm text-ink/55">No visits in the last 30 days yet. As couples find your page, where they came from shows up here.</li>';
      const descChars = c.description_chars != null ? c.description_chars : (v.description || '').length;
      const items = [
        { ok: !!c.has_photo, label: 'A photo', done: 'Your listing shows a photo.', todo: 'No photo yet. Add your own in the Photos section below.', field: 'vd-photos', cta: 'Add Photos' },
        { ok: !!c.has_phone, label: 'A phone number', done: 'Couples can tap to call you.', todo: 'Add a phone number so couples can tap to call you.', field: 've-phone', cta: 'Add Phone' },
        { ok: !!c.has_website, label: 'A website link', done: 'Couples can click through to your site.', todo: 'Add your website so couples can click through.', field: 've-web', cta: 'Add Website' },
        { ok: !!c.description_ok, label: 'A description of 220 or more characters', done: `${num(descChars)} characters. Good.`, todo: `${num(descChars)} characters so far. A fuller description gives couples more to go on and helps your page show up in search.`, field: 've-desc', cta: 'Edit Description' }
      ];
      const done = items.filter(i => i.ok).length;
      const checklist = items.map(i => `<li class="flex items-start gap-3 py-2.5 border-b border-hairline last:border-0">
          <span class="mt-0.5 shrink-0 w-5 h-5 rounded-full flex items-center justify-center text-[11px] ${i.ok ? 'bg-spruce-800 text-ivory' : 'border border-hairline text-ink/40'}">${i.ok ? '✓' : ''}</span>
          <span class="flex-1 text-sm"><span class="${i.ok ? 'text-ink/60' : 'font-medium'}">${i.label}</span><span class="block text-xs text-ink/55 mt-0.5">${i.ok ? i.done : i.todo}</span></span>
          ${i.ok ? '' : (i.field ? `<a href="#${i.field}" data-focus="${i.field}" class="shrink-0 text-xs text-clay-700 underline underline-offset-4 whitespace-nowrap">${i.cta} →</a>` : `<a href="${i.href}" class="shrink-0 text-xs text-clay-700 underline underline-offset-4 whitespace-nowrap">${i.cta} →</a>`)}
        </li>`).join('');

      document.getElementById('vd-traffic').innerHTML = `
        <div class="rounded-3xl border border-hairline bg-white p-5 md:p-6">
          <div class="md:flex items-end justify-between gap-4 mb-4">
            <div><p class="display text-2xl">Last 30 days, <span class="serif-i">day by day</span></p><p class="text-xs text-ink/50 mt-1">${num(t.views_30d)} profile views · ${num(t.site_30d)} website clicks · ${num(t.phone_30d)} phone taps</p></div>
            <div class="text-xs text-ink/55 mt-3 md:mt-0 flex flex-wrap gap-4">
              <span class="inline-flex items-center gap-1.5"><i class="inline-block w-3 h-3 rounded-sm" style="background:#3A4A3C"></i>Profile views</span>
              <span class="inline-flex items-center gap-1.5"><i class="inline-block w-3 h-0.5" style="background:#A9694A"></i>Website clicks</span>
              <span class="inline-flex items-center gap-1.5"><i class="inline-block w-3 h-0.5" style="background:#C99B5F"></i>Phone taps</span>
            </div>
          </div>
          <div id="vd-chart"></div>
          <p class="text-xs text-ink/40 mt-3">Real visits only. Bots and crawlers are filtered out before counting, so these numbers may be lower than other tools report.</p>
        </div>
        <div class="grid md:grid-cols-3 gap-4 mt-4">${cards.map(([l, n]) => `
          <div class="rounded-2xl border border-hairline bg-white p-5">
            <p class="display text-4xl">${num(n)}</p><p class="text-xs text-ink/55 mt-1">${l}</p>
            <p class="text-xs text-ink/50 mt-3 pt-3 border-t border-hairline leading-relaxed">${bench}</p>
          </div>`).join('')}</div>
        <div class="grid md:grid-cols-2 gap-4 mt-4">
          <div class="rounded-3xl border border-hairline bg-white p-6">
            <p class="eyebrow text-clay-600">Where Couples Came From</p><p class="text-xs text-ink/50 mt-1 mb-2">Profile views in the last 30 days</p>
            <ul>${refList}</ul>
          </div>
          <div class="rounded-3xl border border-hairline bg-white p-6">
            <div class="flex items-center justify-between gap-3"><p class="eyebrow text-clay-600">Make Your Listing Stronger</p><span class="text-xs text-ink/50">${done} of ${items.length} done</span></div>
            <p class="text-xs text-ink/50 mt-1 mb-2">${done === items.length ? 'Everything couples look for is on your page.' : (VD.verified ? 'Each item takes a minute in the editor below.' : 'Editing unlocks once your account is verified.')}</p>
            <ul>${checklist}</ul>
          </div>
        </div>`;

      document.getElementById('ve-desc').value = v.description||'';
      document.getElementById('ve-phone').value = v.phone||'';
      document.getElementById('ve-web').value = v.website||'';
      document.getElementById('ve-desc-count').textContent = num((v.description||'').length);
      const editable = VD.verified;
      ['ve-desc','ve-phone','ve-web','ve-save'].forEach(id=>{ document.getElementById(id).disabled = !editable; });
      document.getElementById('vd-badge').classList.toggle('hidden', !VD.verified);
      document.getElementById('vd-badge-code').value = '<a href="https://coloradoelopementguide.com/vendor/' + v.slug + '?ref=badge"><img src="https://coloradoelopementguide.com/badge/listed.svg" alt="Listed on Colorado Elopement Guide" width="180"></a>';
    }
    document.addEventListener('input', e => { if (e.target.id === 've-desc') document.getElementById('ve-desc-count').textContent = num(e.target.value.length); });
    document.addEventListener('click', async e=>{
      const m=e.target.closest('[data-vamode]'); if(m){ mode=m.dataset.vamode; paintMode(); return; }
      const f=e.target.closest('[data-focus]'); if(f){ e.preventDefault(); const el=document.getElementById(f.dataset.focus); if(el){ el.scrollIntoView({behavior:'smooth',block:'center'}); if(!el.disabled) setTimeout(()=>el.focus(),350); } return; }
      if(e.target.closest('#vd-signout')){ localStorage.removeItem('ceg_vtoken'); location.reload(); return; }
      if(e.target.closest('#va-submit')){
        const email=document.getElementById('va-email').value.trim(), pass=document.getElementById('va-pass').value;
        const err=document.getElementById('va-err'); err.classList.add('hidden');
        let res;
        if(mode==='signup'){
          const slug=document.getElementById('va-vendor').value;
          res=await rpc('ceg_vendor_signup',{p_email:email,p_password:pass,p_slug:slug});
          if(res && res.token){ try{ fetch('/api/vendor-signup-notify',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({email,vendor:res.vendor,verified:res.verified})}); }catch(_){} }
        } else {
          res=await rpc('ceg_vendor_login',{p_email:email,p_password:pass});
        }
        if(!res || res.error){ err.textContent=(res&&res.error)||'Something went wrong. Try again.'; err.classList.remove('hidden'); return; }
        localStorage.setItem('ceg_vtoken',res.token);
        location.reload();
      }
      if(e.target.closest('#vd-wait')){
        const out=document.getElementById('vd-wait-msg'); out.textContent='Saving…';
        try{ const r=await fetch('/api/featured-waitlist',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({token:vtok()})}); const res=await r.json(); out.textContent = res&&res.ok ? 'You are on the waitlist. We will email you when a spot opens.' : ((res&&res.error)||'Could not save. Try again.'); }
        catch(_){ out.textContent='Could not save. Try again.'; }
        return;
      }
      if(e.target.closest('#vd-badge-copy')){
        const ta=document.getElementById('vd-badge-code'), msg=document.getElementById('vd-badge-msg');
        try{ await navigator.clipboard.writeText(ta.value); msg.textContent='Copied ✓'; }
        catch(_){ ta.focus(); ta.select(); msg.textContent='Select the code and copy it'; }
        setTimeout(()=>{ msg.textContent=''; }, 2500);
        return;
      }
      if(e.target.closest('#sp-save')){
        const pass=document.getElementById('sp-pass').value;
        const msg=document.getElementById('sp-msg'); msg.textContent='';
        const res=await rpc('ceg_vendor_set_password',{p_token:vtok(),p_password:pass});
        if(res && res.ok){ msg.textContent='Saved ✓'; VD.has_password=true; document.getElementById('vd-setpw').classList.add('hidden'); }
        else { msg.textContent=(res&&res.error)||'Could not save'; }
        return;
      }
      if(e.target.closest('#ve-save')){
        const ok=await rpc('ceg_vendor_update',{p_token:vtok(),
          p_phone:document.getElementById('ve-phone').value,
          p_website:document.getElementById('ve-web').value,
          p_description:document.getElementById('ve-desc').value});
        document.getElementById('ve-msg').textContent = ok?'Saved ✓ · rebuilding site…':'Could not save';
        if(ok){
          try{ fetch('/api/refresh-site',{method:'POST'}); }catch(_){}
          const fresh=await rpc('ceg_vendor_get',{p_token:vtok()});
          if(fresh){ VD=fresh; paint(); drawChart(); document.getElementById('ve-msg').textContent='Saved ✓ · rebuilding site…'; }
        }
      }
    });
    document.addEventListener('DOMContentLoaded', boot);
  </script>
</Base>
