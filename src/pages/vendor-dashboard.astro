---
import Base from '../layouts/Base.astro';
import { allVendors } from '../lib/vendors';
import { CATEGORIES, REGIONS } from '../lib/taxonomy';
const vendors = await allVendors();
const vlist = vendors.map(v => ({ s: v.slug, n: v.name }));
const catNames = Object.fromEntries(Object.entries(CATEGORIES).map(([k,c]) => [k, c.name]));
const regNames = Object.fromEntries(Object.entries(REGIONS).map(([k,r]) => [k, r.name]));
---
<Base title="Vendor Dashboard | Colorado Elopement Guide" description="Manage your free listing: update your details and see how many couples click through to you." noindex={true}>
  <div class="max-w-5xl mx-auto px-5 md:px-8 pt-12 pb-4">
    <div id="vd-loading" class="py-24 text-center text-ink/50">Opening your dashboard…</div>

    <!-- AUTH -->
    <div id="vd-auth" class="hidden">
      <p class="eyebrow text-clay-600 mb-3">For Colorado Vendors</p>
      <h1 class="display text-4xl md:text-5xl leading-tight">Your listing, <span class="serif-i">your numbers</span></h1>
      <p class="text-ink/65 mt-4 leading-relaxed max-w-2xl">Create a free vendor account to manage your listing and see exactly how many couples view your page, click through to your site, and tap your phone number. Real counts, bot filtered, never inflated.</p>
      <div class="mt-7 rounded-3xl border border-hairline bg-white p-6 md:p-7 max-w-md">
        <div class="flex gap-1.5 mb-5">
          <button data-vamode="signup" class="vam-btn flex-1 rounded-full px-4 py-2.5 text-sm font-medium">Create Account</button>
          <button data-vamode="signin" class="vam-btn flex-1 rounded-full px-4 py-2.5 text-sm font-medium">Sign In</button>
        </div>
        <div class="space-y-4">
          <div id="va-vendor-wrap"><label class="eyebrow text-ink/60 block mb-2">Your Business</label>
            <select id="va-vendor" class="w-full rounded-xl border border-hairline bg-ivory px-4 py-3 text-sm"><option value="">Select your listing…</option></select></div>
          <div><label class="eyebrow text-ink/60 block mb-2">Business Email</label>
            <input id="va-email" type="email" required class="w-full rounded-xl border border-hairline bg-ivory px-4 py-3 text-sm" placeholder="you@yourbusiness.com" />
            <p id="va-domhint" class="text-xs text-ink/40 mt-2 hidden">Use an email at your business domain and you're verified instantly.</p></div>
          <div><label class="eyebrow text-ink/60 block mb-2">Password</label>
            <input id="va-pass" type="password" minlength="8" required class="w-full rounded-xl border border-hairline bg-ivory px-4 py-3 text-sm" placeholder="8+ characters" /></div>
          <p id="va-err" class="hidden text-sm rounded-xl border border-clay-500 bg-clay-50 text-clay-700 px-4 py-3"></p>
          <button id="va-submit" class="w-full rounded-full bg-ink text-ivory px-7 py-3.5 text-sm font-semibold hover:bg-spruce-800 transition-colors">Create My Vendor Account</button>
        </div>
      </div>
    </div>

    <!-- DASHBOARD -->
    <div id="vd-app" class="hidden">
      <div class="md:flex items-start justify-between gap-6">
        <div>
          <p class="eyebrow text-clay-600 mb-2">Vendor Dashboard</p>
          <h1 class="display text-3xl md:text-4xl leading-tight" id="vd-name"></h1>
          <p class="text-sm text-ink/55 mt-2" id="vd-meta"></p>
        </div>
        <div class="mt-4 md:mt-0 flex gap-2.5 text-sm shrink-0">
          <a id="vd-view" href="#" class="rounded-full border border-ink/60 px-5 py-2.5 font-medium hover:bg-parchment">View My Listing</a>
          <button id="vd-signout" class="rounded-full border border-hairline px-5 py-2.5 text-ink/60 hover:bg-parchment">Sign Out</button>
        </div>
      </div>
      <div id="vd-pending" class="hidden mt-6 rounded-2xl border border-gold/60 bg-gold/10 px-5 py-4 text-sm">Your account is pending verification because your email domain doesn't match your listing's website. We review these within one business day; editing unlocks after that. Your stats are live below.</div>
      <p class="eyebrow text-clay-600 mt-10 mb-4">Last 30 Days</p>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4" id="vd-stats"></div>
      <div class="md:grid md:grid-cols-5 gap-6 mt-10">
        <div class="md:col-span-3">
          <p class="eyebrow text-clay-600 mb-4">Your Listing</p>
          <div class="rounded-3xl border border-hairline bg-white p-6 space-y-4">
            <div><label class="eyebrow text-ink/60 block mb-2">Description</label>
              <textarea id="ve-desc" rows="5" class="w-full rounded-xl border border-hairline bg-ivory px-4 py-3 text-sm"></textarea></div>
            <div class="grid md:grid-cols-2 gap-4">
              <div><label class="eyebrow text-ink/60 block mb-2">Phone</label>
                <input id="ve-phone" class="w-full rounded-xl border border-hairline bg-ivory px-4 py-3 text-sm" /></div>
              <div><label class="eyebrow text-ink/60 block mb-2">Website</label>
                <input id="ve-web" class="w-full rounded-xl border border-hairline bg-ivory px-4 py-3 text-sm" placeholder="https://…" /></div>
            </div>
            <div class="flex items-center gap-4">
              <button id="ve-save" class="rounded-full bg-ink text-ivory px-7 py-3 text-sm font-semibold hover:bg-spruce-800">Save Changes</button>
              <span id="ve-msg" class="text-sm text-ink/40"></span>
            </div>
            <p class="text-xs text-ink/40">Changes go live on the site within a few minutes.</p>
          </div>
        </div>
        <div class="md:col-span-2 mt-8 md:mt-0">
          <p class="eyebrow text-clay-600 mb-4">Get Seen First</p>
          <div class="rounded-3xl border-2 border-clay-500 bg-white p-6">
            <p class="display text-2xl">Featured<span class="serif-i"> placement</span></p>
            <p class="display text-3xl mt-2">$40<span class="text-base text-ink/40"> / month</span></p>
            <ul class="mt-4 space-y-2 text-sm text-ink/75">
              <li>✓ Top of your category and region pages, always labeled</li>
              <li>✓ Homepage rotation</li>
              <li>✓ Cancel anytime, no contract</li>
            </ul>
            <a href="https://buy.stripe.com/7sYaEZffj1AaaWr93A9oc02" rel="noopener" class="inline-block mt-5 rounded-full bg-clay-500 text-ivory px-6 py-3 text-sm font-semibold hover:bg-clay-600 transition-colors">Go Featured, First Month $1 →</a>
            <p class="mt-3 text-xs text-ink/50">Use code <strong>FIRSTMONTH1</strong> at checkout.</p>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script is:inline define:vars={{ vlist, catNames, regNames }}>
    const SB = 'https://yucgsuzveabsgntlmste.supabase.co/rest/v1/rpc/';
    const SBK = 'sb_publishable_acsHsb9mrZ756aT12EgAPQ_GugWXmjM';
    const rpc = (fn, args) => fetch(SB + fn, { method:'POST', headers:{ apikey:SBK, Authorization:'Bearer '+SBK, 'Content-Type':'application/json' }, body: JSON.stringify(args) }).then(r => r.ok ? r.json() : null).catch(()=>null);
    const vtok = () => localStorage.getItem('ceg_vtoken');
    const esc = s => String(s ?? '').replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
    let mode='signup', VD=null;
    function show(which){ for (const id of ['loading','auth','app']) document.getElementById('vd-'+id).classList.toggle('hidden', id!==which); }
    function paintMode(){
      document.querySelectorAll('.vam-btn').forEach(b=>{
        const on=b.dataset.vamode===mode;
        b.className='vam-btn flex-1 rounded-full px-4 py-2.5 text-sm font-medium '+(on?'bg-ink text-ivory':'bg-parchment text-ink/60 hover:bg-hairline/60');
      });
      document.getElementById('va-vendor-wrap').classList.toggle('hidden', mode!=='signup');
      document.getElementById('va-domhint').classList.toggle('hidden', mode!=='signup');
      document.getElementById('va-submit').textContent = mode==='signup' ? 'Create My Vendor Account' : 'Sign In';
    }
    async function boot(){
      const sel=document.getElementById('va-vendor');
      vlist.sort((a,b)=>a.n.localeCompare(b.n)).forEach(v=>{ const o=document.createElement('option'); o.value=v.s; o.textContent=v.n; sel.appendChild(o); });
      const pre=new URLSearchParams(location.search).get('vendor'); if(pre) sel.value=pre;
      if (!vtok()) { show('auth'); paintMode(); return; }
      VD = await rpc('ceg_vendor_get', { p_token: vtok() });
      if (!VD) { localStorage.removeItem('ceg_vtoken'); show('auth'); paintMode(); return; }
      paint(); show('app');
    }
    function paint(){
      const v=VD.vendor, s=VD.stats;
      document.getElementById('vd-name').textContent = v.name;
      document.getElementById('vd-meta').textContent = `${catNames[v.category]||''} · ${regNames[v.sub_region]||''} · signed in as ${VD.email}`;
      document.getElementById('vd-view').href = '/vendor/' + v.slug;
      document.getElementById('vd-pending').classList.toggle('hidden', VD.verified);
      const cards=[['Profile Views',s.views_30d],['Website Clicks',s.site_clicks_30d],['Phone Taps',s.phone_clicks_30d],['All Time Views',s.views_total]];
      document.getElementById('vd-stats').innerHTML = cards.map(([l,n])=>`
        <div class="rounded-2xl border border-hairline bg-white p-5 text-center">
          <p class="display text-3xl">${n??0}</p><p class="text-xs text-ink/55 mt-1">${l}</p>
        </div>`).join('');
      document.getElementById('ve-desc').value = v.description||'';
      document.getElementById('ve-phone').value = v.phone||'';
      document.getElementById('ve-web').value = v.website||'';
      const editable = VD.verified;
      ['ve-desc','ve-phone','ve-web','ve-save'].forEach(id=>{ document.getElementById(id).disabled = !editable; });
    }
    document.addEventListener('click', async e=>{
      const m=e.target.closest('[data-vamode]'); if(m){ mode=m.dataset.vamode; paintMode(); return; }
      if(e.target.closest('#vd-signout')){ localStorage.removeItem('ceg_vtoken'); location.reload(); return; }
      if(e.target.closest('#va-submit')){
        const email=document.getElementById('va-email').value.trim(), pass=document.getElementById('va-pass').value;
        const err=document.getElementById('va-err'); err.classList.add('hidden');
        let res;
        if(mode==='signup'){
          const slug=document.getElementById('va-vendor').value;
          res=await rpc('ceg_vendor_signup',{p_email:email,p_password:pass,p_slug:slug});
          if(res && res.token){ try{ fetch('/api/vendor-signup-notify',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({email,vendor:res.vendor,verified:res.verified})}); }catch(_){} }
        } else {
          res=await rpc('ceg_vendor_login',{p_email:email,p_password:pass});
        }
        if(!res || res.error){ err.textContent=(res&&res.error)||'Something went wrong. Try again.'; err.classList.remove('hidden'); return; }
        localStorage.setItem('ceg_vtoken',res.token);
        location.reload();
      }
      if(e.target.closest('#ve-save')){
        const ok=await rpc('ceg_vendor_update',{p_token:vtok(),
          p_phone:document.getElementById('ve-phone').value,
          p_website:document.getElementById('ve-web').value,
          p_description:document.getElementById('ve-desc').value});
        document.getElementById('ve-msg').textContent = ok?'Saved ✓ · rebuilding site…':'Could not save';
        if(ok){ try{ fetch('/api/refresh-site',{method:'POST'}); }catch(_){} }
      }
    });
    document.addEventListener('DOMContentLoaded', boot);
  </script>
</Base>
