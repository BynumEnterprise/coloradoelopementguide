---
import Base from '../layouts/Base.astro';
import { allVendors } from '../lib/vendors';
import { CATEGORIES, REGIONS } from '../lib/taxonomy';
import { gimg, regionImg } from '../lib/assets';
const vendors = await allVendors();
const index = vendors.map(v => ({ s: v.slug, n: v.name, c: v.category, r: v.sub_region, i: gimg(v.image_url, 800, 500) || regionImg(v.sub_region) }));
const catNames = Object.fromEntries(Object.entries(CATEGORIES).map(([k,c]) => [k, c.name]));
const regNames = Object.fromEntries(Object.entries(REGIONS).map(([k,r]) => [k, r.name]));
---
<Base title="My vendors | Colorado Elopement Guide" description="Your saved Colorado elopement vendors, all in one place." noindex={true}>
  <div class="max-w-5xl mx-auto px-5 md:px-8 pt-14">
    <p class="eyebrow text-clay-600 mb-3">Your shortlist</p>
    <h1 class="display text-4xl md:text-5xl leading-tight">My <span class="serif-i">vendors</span></h1>
    <p class="text-ink/65 mt-4 leading-relaxed max-w-2xl">Tap the ♡ on any vendor to build your team here. Your list is saved on this device.</p>
    <div class="mt-5 rounded-2xl border border-clay-500/40 bg-clay-50 p-5 text-sm" id="ml-acct-cta">
      <strong>Want notes, booking status, and sync across devices?</strong>
      <a href="/account" class="underline underline-offset-4 ml-1">Create your free planner account →</a>
      <span class="text-ink/50 block mt-1">Everything you've hearted comes with you.</span>
    </div>
    <div id="ml-empty" class="hidden mt-10 rounded-3xl border border-hairline bg-white p-10 text-center">
      <p class="display text-2xl">Nothing saved <span class="serif-i">yet</span></p>
      <p class="text-ink/60 mt-2 text-sm">Browse <a href="/vendors" class="underline underline-offset-4">all vendors</a> or start with <a href="/category/photographers" class="underline underline-offset-4">photographers</a>, and tap the heart on anyone you like.</p>
    </div>
    <div id="ml-groups" class="mt-8"></div>
    <div id="ml-email" class="hidden mt-12 rounded-3xl bg-spruce-900 text-ivory p-8">
      <h2 class="display text-2xl mb-2">Email me <span class="serif-i">my list</span></h2>
      <p class="text-sm text-ivory/70 mb-5">We'll send your saved vendors with links. Subject line: "Your saved Colorado elopement vendors".</p>
      <form method="post" action="/api/savelist" class="flex flex-wrap gap-2.5" id="ml-form">
        <input type="hidden" name="slugs" id="ml-slugs" />
        <input type="email" name="email" required placeholder="you@example.com" class="flex-1 min-w-[210px] rounded-full px-5 py-3 text-ink text-sm bg-ivory placeholder-ink/40 outline-none focus:ring-2 focus:ring-gold" />
        <button class="rounded-full bg-clay-500 hover:bg-clay-600 px-6 py-3 text-sm font-medium transition-colors">Send my list</button>
      </form>
    </div>
  </div>
  <script is:inline define:vars={{ index, catNames, regNames }}>
    function render(){
      const saved = CEG.get();
      const items = index.filter(v => saved.includes(v.s));
      document.getElementById('ml-empty').classList.toggle('hidden', items.length > 0);
      document.getElementById('ml-email').classList.toggle('hidden', items.length === 0);
      document.getElementById('ml-slugs').value = items.map(v=>v.s).join(',');
      const groups = {};
      items.forEach(v => (groups[v.c] = groups[v.c] || []).push(v));
      document.getElementById('ml-groups').innerHTML = Object.entries(groups).map(([c, vs]) => `
        <section class="pt-8">
          <h2 class="display text-2xl mb-4">${catNames[c] || c}</h2>
          <div class="grid gap-5 md:grid-cols-3">${vs.map(v => `
            <div class="rounded-2xl overflow-hidden bg-white border border-hairline">
              <a href="/vendor/${v.s}"><img src="${v.i}" alt="${v.n}" class="h-40 w-full object-cover" loading="lazy" /></a>
              <div class="p-4">
                <a href="/vendor/${v.s}" class="font-medium text-ink hover:text-clay-700">${v.n}</a>
                <p class="text-xs text-ink/50 mt-1">${regNames[v.r] || ''}</p>
                <button data-save="${v.s}" class="mt-3 text-xs text-clay-700 underline underline-offset-4">Remove</button>
              </div>
            </div>`).join('')}</div>
        </section>`).join('');
      CEG.paint();
    }
    document.addEventListener('DOMContentLoaded', render);
    document.addEventListener('click', function(e){ if (e.target.closest('[data-save]')) setTimeout(render, 50); });
  </script>
</Base>
