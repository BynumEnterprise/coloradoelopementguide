---
import Base from '../../layouts/Base.astro';
import VendorCard from '../../components/VendorCard.astro';
import EmailCapture from '../../components/EmailCapture.astro';
import { allVendors } from '../../lib/vendors';
import { CATEGORIES, REGIONS } from '../../lib/taxonomy';
export async function getStaticPaths() {
  return Object.keys(CATEGORIES).map(cat => ({ params: { cat } }));
}
const { cat } = Astro.params;
const meta = CATEGORIES[cat];
const vendors = (await allVendors()).filter(v => v.category === cat);
const byRegion = Object.keys(REGIONS).map(r => [r, vendors.filter(v => v.sub_region===r)]).filter(([,vs]) => vs.length);
---
<Base title={`${meta.name} in Colorado — elopement & micro-wedding | Colorado Elopement Guide`} description={meta.blurb}>
  <div class="max-w-6xl mx-auto px-4 py-10">
    <h1 class="display text-3xl text-pine-900">{meta.name} in Colorado</h1>
    <p class="text-stone-600 mt-2 max-w-2xl">{meta.blurb} {vendors.length} listed.</p>
    {byRegion.map(([r, vs]) => (
      <section class="mt-10">
        <h2 class="display text-xl text-pine-900 mb-4"><a href={`/region/${r}`} class="hover:underline">{REGIONS[r].name}</a> <span class="text-stone-400 text-sm font-normal">({vs.length})</span></h2>
        <div class="grid gap-4 md:grid-cols-3">{vs.map(v => <VendorCard v={v} />)}</div>
      </section>
    ))}
    <div class="mt-12"><EmailCapture /></div>
  </div>
</Base>
