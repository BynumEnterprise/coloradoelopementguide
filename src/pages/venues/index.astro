---
import Base from '../../layouts/Base.astro';
import EmailCapture from '../../components/EmailCapture.astro';
import { allVendors } from '../../lib/vendors';
import { regionImg } from '../../lib/assets';
import { VENUE_PAGES, MIN_VENUES, matchVenues } from '../../data/venue-pages';

const all = await allVendors();
const pages = VENUE_PAGES.map(p => ({ p, n: matchVenues(p, all).length })).filter(x => x.n >= MIN_VENUES);
const total = all.filter(v => v.category === 'venues').length;
const site = 'https://coloradoelopementguide.com';
const ld = {
  '@context': 'https://schema.org', '@type': 'CollectionPage',
  name: 'Colorado Wedding Venues by Town', url: `${site}/venues/`,
  hasPart: pages.map(({ p }) => ({ '@type': 'WebPage', name: p.h1[0], url: `${site}/venues/${p.slug}/` }))
};
const crumbs = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${site}/` },
    { '@type': 'ListItem', position: 2, name: 'Wedding Venues', item: `${site}/venues/` }
  ]
};
---
<Base title="Colorado Wedding Venues by Town for Elopements and Small Weddings | Colorado Elopement Guide"
  description="Colorado wedding venues for elopements and small weddings, town by town: Estes Park, Colorado Springs, Boulder, Denver, Fort Collins, Vail, Aspen and Telluride.">
  <script is:inline type="application/ld+json" slot="head" set:html={JSON.stringify(ld)} />
  <script is:inline type="application/ld+json" slot="head" set:html={JSON.stringify(crumbs)} />
  <div class="max-w-7xl mx-auto px-5 md:px-8 pt-14">
    <nav aria-label="Breadcrumb" class="eyebrow text-clay-600 mb-3"><a href="/" class="hover:text-ink">Home</a> · Wedding Venues</nav>
    <h1 class="display text-4xl md:text-5xl leading-tight max-w-3xl">Colorado Wedding Venues <span class="serif-i">by town</span></h1>
    <p class="text-ink/70 mt-4 max-w-2xl leading-relaxed">{total} live venues that welcome elopements and small weddings, sorted into the towns couples actually search for. Each page explains the setting, the season and the permit question for that town, then lists every venue we have there, ranked by Google rating and review count. Heart the ones you like and they land in your planner.</p>
    <div class="grid gap-4 md:grid-cols-3 pt-10">
      {pages.map(({ p, n }) => (
        <a href={`/venues/${p.slug}`} class="img-tile group relative rounded-2xl overflow-hidden h-56">
          <img src={regionImg(p.region)} alt={`${p.town} wedding venues`} loading="lazy" class="absolute inset-0 w-full h-full object-cover" />
          <div class="absolute inset-0 bg-gradient-to-t from-ink/80 via-ink/10 to-transparent"></div>
          <div class="absolute bottom-0 p-5">
            <p class="display text-ivory text-xl leading-tight">{p.h1[0]}</p>
            <p class="text-xs text-ivory/75 mt-1">{n} venues →</p>
          </div>
        </a>
      ))}
    </div>
    <p class="mt-8 text-sm text-ink/60">Looking for everything at once? <a href="/category/venues" class="underline underline-offset-4">See all venues by region</a> or <a href="/guides" class="underline underline-offset-4">read the planning guides</a>.</p>
    <div class="pt-16"><EmailCapture /></div>
  </div>
</Base>
