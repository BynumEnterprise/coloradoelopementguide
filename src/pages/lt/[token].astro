---
export const prerender = false;
const { token } = Astro.params;
const safe = /^[0-9a-fA-F-]{36}$/.test(token || '') ? token : '';
const merge = Astro.url.searchParams.get('merge') || '';
---
<!doctype html>
<html>
<head><meta charset="utf-8" /><title>Opening your planner…</title><meta name="robots" content="noindex" /></head>
<body style="font-family:Georgia,serif;color:#1f1d1a;background:#f2ede3;text-align:center;padding:80px 20px;">
  <p>Opening your planner…</p>
  <script is:inline define:vars={{ safe, merge }}>
    let u = safe ? '/account?lt=' + safe : '/account';
    if (safe && merge) u += '&merge=' + encodeURIComponent(merge);
    location.replace(u);
  </script>
</body>
</html>
