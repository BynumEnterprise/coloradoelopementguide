---
import Base from '../layouts/Base.astro';
import VendorCard from '../components/VendorCard.astro';
import VendorFilter from '../components/VendorFilter.astro';
import { allVendors } from '../lib/vendors';
const vendors = await allVendors();
---
<Base title="All Colorado elopement & micro-wedding vendors | Colorado Elopement Guide"
  description={`Browse all ${vendors.length} Colorado elopement photographers, venues, officiants, florists, planners and hair & makeup artists.`}>
  <div class="max-w-7xl mx-auto px-5 md:px-8 pt-14">
    <p class="eyebrow text-clay-600 mb-3">The whole guide</p>
    <h1 class="display text-4xl md:text-5xl leading-tight">All vendors <span class="serif-i">({vendors.length})</span></h1>
    <h2 class="sr-only">Every listed vendor</h2>
    <p class="mt-4 text-sm text-ink/60 max-w-2xl">Filter by region, category, starting price and style. Region matches vendors based there and vendors who list it as a place they serve. Starting prices come from the vendor or their own published pricing page.</p>
    <VendorFilter vendors={vendors} />
    <div id="vf-source" class="grid gap-5 md:grid-cols-3 lg:grid-cols-4 mt-8">{vendors.map(v => <div data-vcard={v.slug}><VendorCard v={v} /></div>)}</div>
  </div>
</Base>
