---
import Base from '../layouts/Base.astro';
import VendorCard from '../components/VendorCard.astro';
import { allVendors } from '../lib/vendors';
const vendors = await allVendors();
---
<Base title="All Colorado elopement & micro-wedding vendors | Colorado Elopement Guide"
  description={`Browse all ${vendors.length} Colorado elopement photographers, venues, officiants, florists, planners and hair & makeup artists.`}>
  <div class="max-w-7xl mx-auto px-5 md:px-8 pt-14">
    <p class="eyebrow text-clay-600 mb-3">The whole guide</p>
    <h1 class="display text-4xl md:text-5xl leading-tight">All vendors <span class="serif-i">({vendors.length})</span></h1>
    <div class="grid gap-5 md:grid-cols-3 lg:grid-cols-4 mt-10">{vendors.map(v => <VendorCard v={v} />)}</div>
  </div>
</Base>
