---
import Base from '../layouts/Base.astro';
import { allVendors } from '../lib/vendors';
import { REGIONS } from '../lib/taxonomy';
const vendors = await allVendors();
---
<Base title="Colorado elopement regions — where to elope | Colorado Elopement Guide"
  description="Estes Park & RMNP, Summit County, Telluride, Colorado Springs, Boulder, Vail & Aspen — browse elopement vendors by Colorado region.">
  <div class="max-w-6xl mx-auto px-4 py-10">
    <h1 class="display text-3xl text-pine-900">Choose your corner of Colorado</h1>
    <div class="grid gap-4 md:grid-cols-3 mt-8">
      {Object.entries(REGIONS).map(([slug, r]) => (
        <a href={`/region/${slug}`} class="rounded-xl border border-stone-200 bg-white p-5 hover:shadow-md">
          <h2 class="font-semibold text-pine-900">{r.name}</h2>
          <p class="text-sm text-stone-600 mt-1">{r.blurb}</p>
          <p class="text-xs text-stone-400 mt-2">{vendors.filter(v => v.sub_region===slug).length} vendors</p>
        </a>
      ))}
    </div>
  </div>
</Base>
