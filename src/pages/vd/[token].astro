---
export const prerender = false;
const { token } = Astro.params;
const safe = /^[0-9a-fA-F-]{36}$/.test(token || '') ? token : '';
---
<!doctype html>
<html>
<head><meta charset="utf-8" /><title>Opening your dashboard…</title><meta name="robots" content="noindex" /></head>
<body style="font-family:Georgia,serif;color:#1f1d1a;background:#f2ede3;text-align:center;padding:80px 20px;">
  <p>Opening your dashboard…</p>
  <script is:inline define:vars={{ safe }}>
    location.replace(safe ? '/vendor-dashboard?t=' + safe : '/vendor-dashboard');
  </script>
</body>
</html>
