---
import Base from '../layouts/Base.astro';
import { CATEGORIES, REGIONS } from '../lib/taxonomy';
const catNames = Object.fromEntries(Object.entries(CATEGORIES).map(([k,c]) => [k, c.name]));
const regNames = Object.fromEntries(Object.entries(REGIONS).map(([k,r]) => [k, r.name]));
---
<Base title="Owner Dashboard | Colorado Elopement Guide" description="Private owner analytics for Colorado Elopement Guide." noindex={true}>
  <div class="max-w-7xl mx-auto px-5 md:px-8 pt-12 pb-4">
    <div id="ad-loading" class="py-24 text-center text-ink/50">Opening the dashboard…</div>

    <!-- SIGN IN -->
    <div id="ad-auth" class="hidden">
      <p class="eyebrow text-clay-600 mb-3">Owner Access</p>
      <h1 class="display text-4xl md:text-5xl leading-tight">The guide, <span class="serif-i">by the numbers</span></h1>
      <p class="text-ink/65 mt-4 leading-relaxed max-w-2xl">Every vendor, every view, every click. Live from the database, bot filtered, never inflated.</p>
      <div class="mt-7 rounded-3xl border border-hairline bg-white p-6 md:p-7 max-w-md">
        <div class="space-y-4">
          <div><label class="eyebrow text-ink/60 block mb-2">Email</label>
            <input id="aa-email" type="email" autocomplete="username" required class="w-full rounded-xl border border-hairline bg-ivory px-4 py-3 text-sm" placeholder="you@example.com" /></div>
          <div><label class="eyebrow text-ink/60 block mb-2">Password</label>
            <input id="aa-pass" type="password" autocomplete="current-password" required class="w-full rounded-xl border border-hairline bg-ivory px-4 py-3 text-sm" /></div>
          <p id="aa-err" class="hidden text-sm rounded-xl border border-clay-500 bg-clay-50 text-clay-700 px-4 py-3"></p>
          <button id="aa-submit" class="w-full rounded-full bg-ink text-ivory px-7 py-3.5 text-sm font-semibold hover:bg-spruce-800 transition-colors">Sign In</button>
        </div>
      </div>
    </div>

    <!-- DASHBOARD -->
    <div id="ad-app" class="hidden">
      <div class="md:flex items-start justify-between gap-6">
        <div>
          <p class="eyebrow text-clay-600 mb-2">Owner Dashboard</p>
          <h1 class="display text-3xl md:text-4xl leading-tight">Colorado Elopement <span class="serif-i">Guide</span></h1>
          <p class="text-sm text-ink/55 mt-2" id="ad-sub"></p>
        </div>
        <div class="mt-4 md:mt-0 flex flex-wrap gap-2.5 text-sm shrink-0">
          <button id="ad-refresh" class="rounded-full border border-ink/60 px-5 py-2.5 font-medium hover:bg-parchment">Refresh</button>
          <button id="ad-pwtoggle" class="rounded-full border border-hairline px-5 py-2.5 text-ink/60 hover:bg-parchment">Change Password</button>
          <button id="ad-signout" class="rounded-full border border-hairline px-5 py-2.5 text-ink/60 hover:bg-parchment">Sign Out</button>
        </div>
      </div>
      <div id="ad-pw" class="hidden mt-6 rounded-2xl border border-spruce-800/25 bg-parchment px-5 py-4">
        <p class="text-sm font-semibold mb-1">Change password</p>
        <p class="text-sm text-ink/60 mb-3">At least 12 characters. You stay signed in on this device.</p>
        <div class="flex flex-wrap items-center gap-2.5">
          <input id="pw-new" type="password" autocomplete="new-password" minlength="12" class="rounded-xl border border-hairline bg-white px-4 py-2.5 text-sm" placeholder="New password" />
          <input id="pw-confirm" type="password" autocomplete="new-password" minlength="12" class="rounded-xl border border-hairline bg-white px-4 py-2.5 text-sm" placeholder="Confirm" />
          <button id="pw-save" class="rounded-full bg-ink text-ivory px-6 py-2.5 text-sm font-semibold hover:bg-spruce-800">Save Password</button>
          <span id="pw-msg" class="text-sm text-ink/50"></span>
        </div>
      </div>

      <!-- TABS -->
      <div class="mt-8 flex gap-1.5 border-b border-hairline overflow-x-auto" id="tabs">
        <button data-tab="traffic" class="tab-btn px-5 py-3 text-sm font-medium rounded-t-xl whitespace-nowrap">Traffic</button>
        <button data-tab="overview" class="tab-btn px-5 py-3 text-sm font-medium rounded-t-xl whitespace-nowrap">Overview</button>
        <button data-tab="vendors" class="tab-btn px-5 py-3 text-sm font-medium rounded-t-xl whitespace-nowrap">Vendors <span id="tab-vcount" class="opacity-50"></span></button>
        <button data-tab="couples" class="tab-btn px-5 py-3 text-sm font-medium rounded-t-xl whitespace-nowrap">Couples <span id="tab-ccount" class="opacity-50"></span></button>
        <button data-tab="outreach" class="tab-btn px-5 py-3 text-sm font-medium rounded-t-xl whitespace-nowrap">Outreach</button>
      </div>

      <div id="pane-traffic" class="pane pt-8"></div>
      <div id="pane-overview" class="pane pt-8 hidden"></div>
      <div id="pane-vendors" class="pane pt-8 hidden"></div>
      <div id="pane-couples" class="pane pt-8 hidden"></div>
      <div id="pane-outreach" class="pane pt-8 hidden"></div>
    </div>
  </div>

  <!-- VENDOR DETAIL DRAWER -->
  <div id="drawer-wrap" class="hidden fixed inset-0 z-50">
    <div id="drawer-bg" class="absolute inset-0 bg-ink/40"></div>
    <aside id="drawer" class="absolute right-0 top-0 h-full w-full max-w-xl bg-ivory border-l border-hairline shadow-2xl overflow-y-auto p-6 md:p-8"></aside>
  </div>

  <script is:inline define:vars={{ catNames, regNames }}>
    const SB = 'https://yucgsuzveabsgntlmste.supabase.co/rest/v1/rpc/';
    const SBK = 'sb_publishable_acsHsb9mrZ756aT12EgAPQ_GugWXmjM';
    const rpc = (fn, args) => fetch(SB + fn, { method:'POST', headers:{ apikey:SBK, Authorization:'Bearer '+SBK, 'Content-Type':'application/json' }, body: JSON.stringify(args) }).then(r => r.ok ? r.json() : null).catch(() => null);
    const tok = () => localStorage.getItem('ceg_admin');
    const esc = s => String(s ?? '').replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
    const num = n => Number(n || 0).toLocaleString('en-US');
    const STATUS_LABEL = { seeded:'Seeded', claimed:'Claimed', featured:'Featured', queued:'Queued', removed:'Removed' };
    const CHIP = { seeded:'bg-parchment text-ink/70 border-hairline', claimed:'bg-spruce-800 text-ivory border-spruce-800', featured:'bg-gold/25 text-clay-700 border-gold/40', queued:'bg-sky-100 text-sky-900 border-sky-200', removed:'bg-hairline/60 text-ink/40 border-hairline line-through' };
    const chip = s => `<span class="text-[11px] rounded-full border px-2.5 py-1 whitespace-nowrap ${CHIP[s]||CHIP.seeded}">${STATUS_LABEL[s]||esc(s)}</span>`;
    const OUT_LABEL = { pending:'Pending', no_email_found:'No Email Found', claimed:'Claimed', unsubscribed:'Unsubscribed' };
    const outLabel = s => OUT_LABEL[s] || (s && s.startsWith('sent') ? 'Sent ' + s.slice(5).toUpperCase() : (s || 'Pending'));
    const EV_LABEL = { profile_view:'Profile view', website_click:'Website click', phone_click:'Phone tap' };
    const fmtDate = s => s ? new Date(s.length === 10 ? s + 'T12:00:00' : s).toLocaleDateString('en-US', { month:'short', day:'numeric', year:'numeric' }) : '';
    const fmtDT = s => s ? new Date(s).toLocaleString('en-US', { month:'short', day:'numeric', hour:'numeric', minute:'2-digit' }) : '';
    const fmtDay = d => new Date(d + 'T12:00:00').toLocaleDateString('en-US', { month:'short', day:'numeric' });
    const ago = s => { if (!s) return 'Never'; const ms = Date.now() - new Date(s); const d = Math.floor(ms / 86400000); if (d < 1) { const h = Math.floor(ms / 3600000); return h < 1 ? 'Just now' : h + 'h ago'; } if (d < 30) return d + 'd ago'; return fmtDate(s); };
    const catShort = c => (catNames[c] || c || '').replace(/^Elopement |^Micro-Wedding /, '');
    const HOSTS = [[/(^|\.)google\./,'Google'],[/(^|\.)pinterest\./,'Pinterest'],[/(^|\.)bing\.com$/,'Bing'],[/(^|\.)duckduckgo\.com$/,'DuckDuckGo'],[/(^|\.)facebook\.com$/,'Facebook'],[/(^|\.)instagram\.com$/,'Instagram'],[/^t\.co$/,'X (Twitter)'],[/(^|\.)reddit\.com$/,'Reddit'],[/(^|\.)yahoo\./,'Yahoo'],[/(^|\.)theknot\.com$/,'The Knot'],[/(^|\.)zola\.com$/,'Zola'],[/(^|\.)chatgpt\.com$/,'ChatGPT'],[/(^|\.)perplexity\.ai$/,'Perplexity']];
    function hostLabel(h){ if (!h || h === '(direct)') return 'Direct (typed, bookmarked or from an app)'; for (const [re, l] of HOSTS) if (re.test(h)) return l; if (/(^|\.)coloradoelopementguide\.com$/.test(h)) return 'Our own pages'; return esc(h); }
    function hostOf(ref){ try { const u = new URL(ref); const h = u.hostname.replace(/^www\./, ''); return /coloradoelopementguide\.com$/.test(h) ? 'our site ' + u.pathname : h; } catch (_) { return ref; } }
    const LEGEND = `<span class="inline-flex items-center gap-1.5"><i class="inline-block w-3 h-3 rounded-sm" style="background:#3A4A3C"></i>Profile views</span><span class="inline-flex items-center gap-1.5"><i class="inline-block w-3 h-0.5" style="background:#A9694A"></i>Site clicks</span><span class="inline-flex items-center gap-1.5"><i class="inline-block w-3 h-0.5" style="background:#C99B5F"></i>Phone taps</span>`;

    let OV = null, VL = [], CP = null, TR = null, trDays = 30, activeTab = 'traffic', sortKey = 'views_30d', sortDir = -1, DRAWER = null, qTimer = null;
    const filters = { status:'live', category:'', region:'', q:'' };
    const CH = {};

    // ---------- inline SVG chart (bars for views, thin lines for clicks) ----------
    function niceStep(max){ const raw = max / 4; const p = Math.pow(10, Math.floor(Math.log10(raw))); const m = raw / p; const f = m <= 1 ? 1 : m <= 2 ? 2 : m <= 5 ? 5 : 10; return Math.max(1, f * p); }
    function chart(id, series, opts){
      opts = opts || {}; CH[id] = { series, opts };
      const el = document.getElementById(id); if (!el) return;
      const W = Math.max(320, el.clientWidth || 900), H = opts.h || 240;
      const keys = opts.keys || ['views', 'site', 'phone'];
      const pl = 38, pr = 10, pt = 14, pb = 28, iw = W - pl - pr, ih = H - pt - pb, n = Math.max(1, series.length);
      const max = Math.max(1, ...series.map(p => Math.max(...keys.map(k => p[k] || 0))));
      const step = niceStep(max), ymax = Math.ceil(max / step) * step;
      const x = i => pl + (i + 0.5) * iw / n, y = v => pt + ih - (v / ymax) * ih;
      const bw = Math.max(1.5, (iw / n) * 0.62);
      let s = `<svg viewBox="0 0 ${W} ${H}" width="${W}" height="${H}" class="block w-full h-auto" role="img" aria-label="${esc(opts.label || 'Daily chart')}">`;
      for (let v = 0; v <= ymax; v += step) { s += `<line x1="${pl}" x2="${W - pr}" y1="${y(v)}" y2="${y(v)}" stroke="#E7E1D5" stroke-width="1"/><text x="${pl - 6}" y="${y(v) + 3.5}" text-anchor="end" font-size="10" fill="#23281F" fill-opacity=".5">${num(v)}</text>`; }
      series.forEach((p, i) => { const v = p.views || 0; if (!v) return; s += `<rect x="${(x(i) - bw / 2).toFixed(1)}" y="${y(v).toFixed(1)}" width="${bw.toFixed(1)}" height="${(pt + ih - y(v)).toFixed(1)}" fill="#3A4A3C" fill-opacity=".85" rx="1"><title>${fmtDay(p.d)}: ${num(v)} ${opts.unit || 'views'}${keys.includes('site') ? `, ${num(p.site)} site clicks, ${num(p.phone)} phone taps` : ''}${keys.includes('visitors') ? `, ${num(p.visitors)} visitors` : ''}</title></rect>`; });
      const line = (key, color) => { if (!keys.includes(key)) return ''; const pts = series.map((p, i) => `${x(i).toFixed(1)},${y(p[key] || 0).toFixed(1)}`).join(' '); return `<polyline points="${pts}" fill="none" stroke="${color}" stroke-width="1.5" stroke-linejoin="round" stroke-linecap="round"/>` + series.map((p, i) => (p[key] || 0) > 0 ? `<circle cx="${x(i).toFixed(1)}" cy="${y(p[key]).toFixed(1)}" r="2.5" fill="${color}"><title>${fmtDay(p.d)}: ${num(p[key])} ${key === 'site' ? 'site clicks' : key === 'visitors' ? 'visitors' : 'phone taps'}</title></circle>` : '').join(''); };
      s += line('site', '#A9694A') + line('phone', '#C99B5F') + line('visitors', '#A9694A');
      const k = opts.every || (n > 60 ? 15 : n > 30 ? 7 : n > 14 ? 5 : 1);
      series.forEach((p, i) => { if ((n - 1 - i) % k === 0) s += `<text x="${x(i).toFixed(1)}" y="${H - 9}" text-anchor="middle" font-size="10" fill="#23281F" fill-opacity=".55">${esc(opts.xlabel ? opts.xlabel(p) : fmtDay(p.d))}</text>`; });
      el.innerHTML = s + '</svg>';
    }
    function rechart(){ Object.keys(CH).forEach(id => { const el = document.getElementById(id); if (el && el.clientWidth > 0) chart(id, CH[id].series, CH[id].opts); }); }
    let rsz = null; window.addEventListener('resize', () => { clearTimeout(rsz); rsz = setTimeout(rechart, 150); });

    // ---------- boot / auth ----------
    function show(which){ for (const id of ['loading', 'auth', 'app']) document.getElementById('ad-' + id).classList.toggle('hidden', id !== which); }
    async function loadAll(){
      OV = await rpc('ceg_admin_overview', { p_token: tok() });
      if (!OV) return false;
      const [v, c, tr] = await Promise.all([rpc('ceg_admin_vendors', { p_token: tok(), p_include_removed: true }), rpc('ceg_admin_couples', { p_token: tok() }), rpc('ceg_admin_traffic', { p_token: tok(), p_days: trDays })]);
      VL = Array.isArray(v) ? v : []; CP = c; TR = tr;
      return true;
    }
    async function boot(){
      if (!tok()) { show('auth'); return; }
      try { localStorage.setItem('ceg_owner', '1'); } catch (_) {}
      const ok = await loadAll();
      if (!ok) { localStorage.removeItem('ceg_admin'); show('auth'); const e = document.getElementById('aa-err'); e.textContent = 'Your session ended. Sign in again.'; e.classList.remove('hidden'); return; }
      paintAll(); show('app'); setTab(activeTab);
    }
    async function signIn(){
      const email = document.getElementById('aa-email').value.trim(), pass = document.getElementById('aa-pass').value;
      const err = document.getElementById('aa-err'); err.classList.add('hidden');
      const btn = document.getElementById('aa-submit'); btn.disabled = true; btn.textContent = 'Signing In…';
      const res = await rpc('ceg_admin_login', { p_email: email, p_password: pass });
      btn.disabled = false; btn.textContent = 'Sign In';
      if (!res || res.error || !res.token) { err.textContent = (res && res.error) || 'Something went wrong. Try again.'; err.classList.remove('hidden'); return; }
      localStorage.setItem('ceg_admin', res.token);
      localStorage.setItem('ceg_owner', '1'); // this device is the owner's: the site tracker skips it from now on
      location.reload();
    }
    function paintAll(){
      const t = OV.totals;
      document.getElementById('ad-sub').textContent = `Live from the database · ${num(t.live_vendors)} live listings · updated ${fmtDT(OV.generated_at)}`;
      document.getElementById('tab-vcount').textContent = `(${num(VL.length)})`;
      document.getElementById('tab-ccount').textContent = CP ? `(${num(CP.counts.couples)})` : '';
      paintTraffic(); paintOverview(); paintVendors(); paintCouples(); paintOutreach();
    }
    function setTab(t){
      activeTab = t;
      document.querySelectorAll('.tab-btn').forEach(b => { const on = b.dataset.tab === t; b.className = 'tab-btn px-5 py-3 text-sm font-medium rounded-t-xl whitespace-nowrap ' + (on ? 'bg-ink text-ivory' : 'text-ink/60 hover:bg-parchment'); });
      document.querySelectorAll('.pane').forEach(p => p.classList.add('hidden'));
      document.getElementById('pane-' + t).classList.remove('hidden');
      rechart();
    }


    // ---------- traffic (first party, cookieless; see /api/track and ceg_admin_traffic) ----------
    const EVENT_LABEL = { vendor_website_click:'Vendor Website Clicks', vendor_phone_click:'Vendor Phone Taps', inquiry_submitted:'Inquiries Submitted', planner_signup:'Planner Signups', vendor_signup:'Vendor Signups', claim_started:'Claims Started', featured_checkout_click:'Featured Checkout Clicks', newsletter_signup:'Newsletter Signups' };
    const DEVICE_LABEL = { mobile:'Mobile', tablet:'Tablet', desktop:'Desktop', unknown:'Unknown' };
    let regionNamer = null; try { regionNamer = new Intl.DisplayNames(['en'], { type: 'region' }); } catch (_) {}
    const countryName = c => { if (!c || c === '??') return 'Unknown'; try { return regionNamer ? regionNamer.of(c) : c; } catch (_) { return c; } };
    const pct = (a, b) => b ? Math.round(100 * a / b) : 0;
    function delta(cur, prev){
      if (!prev) return cur ? '<span class="text-ink/45">No data in the previous period</span>' : '<span class="text-ink/45">No data yet</span>';
      const d = Math.round(100 * (cur - prev) / prev);
      const cls = d > 0 ? 'text-spruce-800' : d < 0 ? 'text-clay-700' : 'text-ink/50';
      return `<span class="${cls} font-medium">${d > 0 ? '↑ ' : d < 0 ? '↓ ' : ''}${Math.abs(d)}%</span> <span class="text-ink/45">vs previous ${trDays} days (${num(prev)})</span>`;
    }
    function sourceLabel(s){ if (s.source === 'Other') return s.host && s.host.startsWith('utm:') ? 'Campaign: ' + esc(s.host.slice(4)) : hostLabel(s.host); if (s.source === 'Direct') return 'Direct (typed, bookmarked or from an app)'; return esc(s.source); }
    function mediaKitText(){
      if (!TR) return '';
      const m = TR.media_kit, end = new Date(), start = new Date(Date.now() - 30 * 86400000);
      const f = d => d.toLocaleDateString('en-US', { month:'long', day:'numeric', year:'numeric' });
      const regs = (m.top_regions || []).map(r => `${regNames[r.region] || r.region} (${num(r.views)})`).join(', ');
      const cats = (m.top_categories || []).map(c => `${catShort(c.category)} (${num(c.views)})`).join(', ');
      return [
        `Colorado Elopement Guide, last 30 days (${f(start)} to ${f(end)})`,
        `Visitors: ${num(m.visitors)}`,
        `Page views: ${num(m.pageviews)}`,
        `Vendor listing views: ${num(m.vendor_page_views)}`,
        `Website and phone clicks sent to vendors: ${num(m.vendor_clicks)}`,
        `Couple inquiries sent through listings: ${num(m.inquiries)}`,
        `Live vendor listings: ${num(m.live_vendors)}`,
        regs ? `Most viewed regions: ${regs}` : '',
        cats ? `Most viewed categories: ${cats}` : '',
        `Counted by our own first party analytics, bots and our own visits excluded.`
      ].filter(Boolean).join('\n');
    }
    function printMediaKit(){
      const w = window.open('', '_blank', 'width=720,height=640'); if (!w) return;
      w.document.write(`<!doctype html><title>Media Kit Numbers</title><body style="font:15px/1.6 Georgia,serif;padding:40px;color:#23281F"><pre style="white-space:pre-wrap;font:inherit">${esc(mediaKitText())}</pre></body>`);
      w.document.close(); w.focus(); w.print();
    }
    function exportPagesCsv(){
      if (!TR) return;
      const cell = v => { const s = v == null ? '' : String(v); return /[",\n]/.test(s) ? '"' + s.replace(/"/g, '""') + '"' : s; };
      const rows = (TR.pages || []).map(p => [p.path, p.views, p.visitors, 'https://coloradoelopementguide.com' + p.path].map(cell).join(','));
      const csv = ['path,views,unique_visitors,url'].concat(rows).join('\n');
      const a = document.createElement('a'); a.href = URL.createObjectURL(new Blob([csv], { type: 'text/csv' })); a.download = `ceg-top-pages-${trDays}d-${new Date().toISOString().slice(0, 10)}.csv`; a.click(); setTimeout(() => URL.revokeObjectURL(a.href), 2000);
    }
    function paintTraffic(){
      const pane = document.getElementById('pane-traffic');
      if (!TR) { pane.innerHTML = '<p class="text-sm text-ink/50">Could not load traffic. Press Refresh.</p>'; return; }
      const c = TR.kpi.cur, p = TR.kpi.prev, b = TR.business, fu = TR.funnel;
      const pps = x => x.sessions ? x.pageviews / x.sessions : 0;
      const kcard = (label, val, d, fmt) => `<div class="rounded-3xl border border-hairline bg-white p-5"><p class="eyebrow text-ink/50">${label}</p><p class="display text-4xl mt-2">${fmt ? fmt(val) : num(val)}</p><p class="text-xs mt-1.5 leading-relaxed">${d}</p></div>`;
      const pDelta = (() => { const a = pps(c), z = pps(p); if (!z) return '<span class="text-ink/45">No data in the previous period</span>'; const d = Math.round(100 * (a - z) / z); return `<span class="${d > 0 ? 'text-spruce-800' : d < 0 ? 'text-clay-700' : 'text-ink/50'} font-medium">${d > 0 ? '↑ ' : d < 0 ? '↓ ' : ''}${Math.abs(d)}%</span> <span class="text-ink/45">vs previous ${trDays} days (${z.toFixed(2)})</span>`; })();
      const range = [7, 30, 90].map(n => `<button data-range="${n}" class="rounded-full px-4 py-2 text-sm font-medium ${n === trDays ? 'bg-ink text-ivory' : 'border border-hairline text-ink/65 hover:bg-parchment'}">${n} Days</button>`).join('');
      const started = TR.tracking_started ? fmtDate(TR.tracking_started) : 'today';
      const strip = [['Live Vendors', b.live_vendors], ['Claimed', b.claimed], ['Featured', b.featured], ['Verified Vendor Accounts', b.vendor_accounts_verified], ['Couple Accounts', b.couples], ['Subscribers', b.subscribers], [`Inquiries, ${trDays} Days`, b.inquiries_period]];
      const pagesRows = (TR.pages || []).slice(0, 20).map((x, i) => `<tr class="border-t border-hairline"><td class="py-2 pr-2 text-ink/40 tabular-nums">${i + 1}</td><td class="py-2 pr-3 max-w-[340px] truncate"><a href="${esc(x.path)}" target="_blank" rel="noopener" class="hover:text-clay-700">${esc(x.path)}</a></td><td class="py-2 pr-3 text-right tabular-nums">${num(x.views)}</td><td class="py-2 text-right tabular-nums text-ink/60">${num(x.visitors)}</td></tr>`).join('');
      const steps = [['Visitors', fu.visitors, 'Unique visitors in the period'], ['Viewed A Vendor Page', fu.vendor_page_visitors, `${num(fu.vendor_page_views)} vendor page views`], ['Clicked Website Or Phone', fu.click_visitors, `${num(fu.clicks)} clicks sent to vendors`], ['Sent An Inquiry', fu.inquiries, 'Inquiry forms received']];
      const fmax = Math.max(1, fu.visitors || 0);
      const evRows = (TR.events || []).map(e => `<tr class="border-t border-hairline"><td class="py-2 pr-3">${EVENT_LABEL[e.event] || esc(e.event)}</td><td class="py-2 pr-3 text-right tabular-nums">${num(e.cur)}</td><td class="py-2 text-right tabular-nums text-ink/50">${num(e.prev)}</td></tr>`).join('');
