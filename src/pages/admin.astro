          ${kv('Last Login', v.account_email ? ago(v.account_last_login) : '')}
          ${kv('Contact Email', v.contact_email ? esc(v.contact_email) : '')}
          ${kv('Outreach', esc(outLabel(v.outreach_status)) + (v.outreach_sent_at ? ' · sent ' + fmtDate(v.outreach_sent_at) : '') + (v.account_unsubscribed ? ' · account unsubscribed from drips' : ''))}
          ${kv('Claimed', v.claimed_at ? fmtDate(v.claimed_at) : 'Not claimed')}
          ${kv('Featured Until', v.featured_until ? fmtDate(v.featured_until) : '')}
          ${kv('Website', v.website ? `<a href="${esc(v.website)}" target="_blank" rel="noopener" class="underline underline-offset-4 break-all">${esc(v.website.replace(/^https?:\/\/(www\.)?/, '').replace(/\/$/, ''))}</a>` : '')}
          ${kv('Phone', v.phone ? esc(v.phone) : '')}
        </dl>
        ${d ? detailBody(d) : '<p class="mt-6 text-sm text-ink/50">Loading traffic…</p>'}`;
      if (d) chart('ch-drawer', d.series || [], { h: 160, every: 30, label: 'Daily views for the last 90 days' });
    }
    function detailBody(d){
      const t = d.totals || {};
      const mini = [['Views 7d', t.views_7d], ['Views 30d', t.views_30d], ['Views All', t.views_all], ['Site Clicks 30d', t.site_30d], ['Phone Taps 30d', t.phone_30d], ['Inquiries', t.inquiries_total]];
      const refs = (d.referrers || []).length ? d.referrers.map(r => `<li class="flex justify-between gap-3 py-1.5 border-b border-hairline last:border-0"><span>${hostLabel(r.host)}</span><span class="text-ink/60 tabular-nums">${num(r.n)}</span></li>`).join('') : '<li class="py-2 text-ink/50">No referrer data yet.</li>';
      const evs = (d.events || []).length ? d.events.map(e => `<tr class="border-t border-hairline"><td class="py-1.5 pr-3 whitespace-nowrap text-ink/70">${fmtDT(e.at)}</td><td class="py-1.5 pr-3 whitespace-nowrap">${EV_LABEL[e.type] || esc(e.type)}</td><td class="py-1.5 text-ink/60 whitespace-nowrap">${e.referrer ? esc(hostOf(e.referrer)) : '<span class="text-ink/35">direct</span>'}</td></tr>`).join('') : '<tr><td class="py-2 text-ink/50" colspan="3">No events since bot filtering began.</td></tr>';
      const inqs = (d.inquiries || []).length ? `<p class="eyebrow text-clay-600 mt-8 mb-3">Inquiries</p><ul class="text-sm rounded-2xl border border-hairline bg-white px-5 py-2">${d.inquiries.map(i => `<li class="py-1.5 border-b border-hairline last:border-0">${esc(i.name || '')} · ${esc(i.email || '')}${i.event_date ? ' · ' + fmtDate(i.event_date) : ''} <span class="text-ink/45">· ${fmtDate(i.at)}</span></li>`).join('')}</ul>` : '';
      const accts = (d.accounts || []).length > 1 ? `<p class="eyebrow text-clay-600 mt-8 mb-3">All Accounts</p><ul class="text-sm rounded-2xl border border-hairline bg-white px-5 py-2">${d.accounts.map(a => `<li class="py-1.5 border-b border-hairline last:border-0">${esc(a.email)} · ${a.verified ? 'Verified' : 'Pending'} · last login ${ago(a.last_login_at)}</li>`).join('')}</ul>` : '';
      return `
        <div class="mt-6 grid grid-cols-3 gap-3">${mini.map(([l, v]) => `<div class="rounded-2xl border border-hairline bg-white p-3 text-center"><p class="display text-2xl">${num(v)}</p><p class="text-[11px] text-ink/55 mt-0.5">${l}</p></div>`).join('')}</div>
        <p class="text-xs text-ink/50 mt-3">Saved by ${num(t.saved_by)} couple${t.saved_by === 1 ? '' : 's'} in their planner.</p>
        <p class="eyebrow text-clay-600 mt-8 mb-3">Last 90 Days</p>
        <div class="rounded-2xl border border-hairline bg-white p-4"><div id="ch-drawer"></div><div class="text-xs text-ink/55 mt-3 flex flex-wrap gap-4">${LEGEND}</div></div>
        <p class="eyebrow text-clay-600 mt-8 mb-3">Referrers, 90 Days</p>
        <ul class="text-sm rounded-2xl border border-hairline bg-white px-5 py-2">${refs}</ul>
        ${inqs}${accts}
        <p class="eyebrow text-clay-600 mt-8 mb-3">Recent Events</p>
        <div class="rounded-2xl border border-hairline bg-white px-5 py-2 overflow-x-auto"><table class="w-full text-sm"><tbody>${evs}</tbody></table></div>
        ${d.vendor && d.vendor.description ? `<p class="eyebrow text-clay-600 mt-8 mb-3">Description</p><p class="text-sm text-ink/70 leading-relaxed">${esc(d.vendor.description)}</p>` : ''}`;
    }
    async function doStatus(act){
      if (!DRAWER) return;
      const v = DRAWER.v, back = (v.claimed_at || v.account_email) ? 'claimed' : 'seeded';
      const status = { feature:'featured', unfeature:back, remove:'removed', restore:back, release:'seeded' }[act];
      if (!status) return;
      if (act === 'remove' && !confirm(`Remove ${v.name} from the site?`)) return;
      const msg = document.getElementById('drawer-msg'); msg.textContent = 'Saving…';
      const res = await rpc('ceg_admin_set_status', { p_token: tok(), p_id: v.id, p_status: status, p_featured_until: null });
      if (!res || res.error) { msg.textContent = (res && res.error) || 'Could not save.'; return; }
      v.status = res.status; v.featured_until = res.featured_until;
      paintDrawer(); document.getElementById('drawer-msg').textContent = 'Saved ✓ · rebuilding site…';
      try { fetch('/api/refresh-site', { method: 'POST' }); } catch (_) {}
      paintVendorTable();
      const ov = await rpc('ceg_admin_overview', { p_token: tok() });
      if (ov) { OV = ov; paintOverview(); paintOutreach(); document.getElementById('ad-sub').textContent = `Live from the database · ${num(OV.totals.live_vendors)} live listings · updated ${fmtDT(OV.generated_at)}`; }
    }

    // ---------- couples ----------
    function paintCouples(){
      const pane = document.getElementById('pane-couples');
      if (!CP) { pane.innerHTML = '<p class="text-sm text-ink/50">Could not load couples.</p>'; return; }
      const c = CP.counts;
      const card = (l, v, sub) => `<div class="rounded-3xl border border-hairline bg-white p-5"><p class="eyebrow text-ink/50">${l}</p><p class="display text-4xl mt-2">${num(v)}</p>${sub ? `<p class="text-xs text-ink/50 mt-1.5">${sub}</p>` : ''}</div>`;
      const rows = (CP.couples || []).map(x => `<tr class="border-t border-hairline"><td class="px-3 py-2.5 whitespace-nowrap">${esc(x.email)}</td><td class="px-3 py-2.5">${esc(x.names || '')}</td><td class="px-3 py-2.5 whitespace-nowrap">${esc(regNames[x.region] || x.region || '')}</td><td class="px-3 py-2.5 whitespace-nowrap">${x.wedding_date ? fmtDate(x.wedding_date) : ''}</td><td class="px-3 py-2.5 text-right tabular-nums">${x.guests != null ? num(x.guests) : ''}</td><td class="px-3 py-2.5 text-right tabular-nums">${num(x.saved)}</td><td class="px-3 py-2.5 text-right tabular-nums">${num(x.booked)}</td><td class="px-3 py-2.5 whitespace-nowrap text-ink/70">${fmtDate(x.created_at)}</td><td class="px-3 py-2.5 whitespace-nowrap text-ink/70">${ago(x.last_login_at)}</td></tr>`).join('');
      const subs = (CP.subscribers || []).map(x => `<tr class="border-t border-hairline"><td class="px-3 py-2.5">${esc(x.email)}</td><td class="px-3 py-2.5 text-ink/70">${esc(x.source || '')}</td><td class="px-3 py-2.5 whitespace-nowrap text-ink/70">${fmtDate(x.created_at)}</td></tr>`).join('');
      pane.innerHTML = `
        <div class="grid grid-cols-2 md:grid-cols-6 gap-4">
          ${card('Couples', c.couples, `${num(c.couples_7d)} new this week`)}${card('With Password', c.with_password, 'Others use email links')}${card('Active This Week', c.active_7d, 'Signed in within 7 days')}${card('Saved Vendors', c.saved_vendors, 'Across all planners')}${card('Booked', c.booked, 'Marked booked by couples')}${card('Subscribers', c.subscribers, 'Newsletter signups')}
        </div>
        <p class="eyebrow text-clay-600 mt-10 mb-4">Planner Accounts</p>
        <div class="overflow-x-auto rounded-3xl border border-hairline bg-white"><table class="w-full min-w-[960px] text-sm"><thead><tr class="bg-parchment/60 text-ink/55 font-medium"><th class="text-left px-3 py-3">Email</th><th class="text-left px-3 py-3">Names</th><th class="text-left px-3 py-3">Region</th><th class="text-left px-3 py-3">Wedding Date</th><th class="text-right px-3 py-3">Guests</th><th class="text-right px-3 py-3">Saved</th><th class="text-right px-3 py-3">Booked</th><th class="text-left px-3 py-3">Created</th><th class="text-left px-3 py-3">Last Login</th></tr></thead><tbody>${rows || '<tr><td colspan="9" class="px-4 py-10 text-center text-ink/50">No couple accounts yet.</td></tr>'}</tbody></table></div>
        <p class="eyebrow text-clay-600 mt-10 mb-4">Subscribers</p>
        <div class="overflow-x-auto rounded-3xl border border-hairline bg-white"><table class="w-full min-w-[480px] text-sm"><thead><tr class="bg-parchment/60 text-ink/55 font-medium"><th class="text-left px-3 py-3">Email</th><th class="text-left px-3 py-3">Source</th><th class="text-left px-3 py-3">Created</th></tr></thead><tbody>${subs || '<tr><td colspan="3" class="px-4 py-10 text-center text-ink/50">No subscribers yet.</td></tr>'}</tbody></table></div>`;
    }

    // ---------- outreach ----------
    function paintOutreach(){
      const f = OV.outreach_funnel || {}, t = OV.totals, os = t.outreach_status || {};
      const steps = [['Queued', f.queued, 'Not released to the site yet'], ['Ready To Send', f.pending_with_email, 'Live, has an email, never contacted'], ['No Email Found', f.no_email, 'Live, no contact address'], ['Sent', f.sent, 'Claim invite delivered'], ['Claimed', f.claimed, 'Listing claimed by the vendor'], ['Unsubscribed', f.unsubscribed, 'Asked not to be contacted'], ['Removed', f.removed, 'Taken off the site']];
      const max = Math.max(1, ...steps.map(s => s[1] || 0));
      document.getElementById('pane-outreach').innerHTML = `
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
          <div class="rounded-3xl border border-hairline bg-white p-5"><p class="eyebrow text-ink/50">Emails Sent, 7 Days</p><p class="display text-4xl mt-2">${num(t.outreach_sent_7d)}</p><p class="text-xs text-ink/50 mt-1.5">Cap is 25 per day</p></div>
          <div class="rounded-3xl border border-hairline bg-white p-5"><p class="eyebrow text-ink/50">Emails Sent, 30 Days</p><p class="display text-4xl mt-2">${num(t.outreach_sent_30d)}</p></div>
          <div class="rounded-3xl border border-hairline bg-white p-5"><p class="eyebrow text-ink/50">Emails Sent, All Time</p><p class="display text-4xl mt-2">${num(t.outreach_sent_all)}</p></div>
          <div class="rounded-3xl border border-hairline bg-white p-5"><p class="eyebrow text-ink/50">Claimed After Outreach</p><p class="display text-4xl mt-2">${num(os.claimed)}</p><p class="text-xs text-ink/50 mt-1.5">${f.sent ? Math.round(100 * (os.claimed || 0) / ((f.sent || 0) + (os.claimed || 0))) + '% of contacted vendors' : 'No sends recorded yet'}</p></div>
        </div>
        <div class="grid md:grid-cols-5 gap-6 mt-6">
          <div class="md:col-span-2 rounded-3xl border border-hairline bg-white p-6">
            <p class="eyebrow text-clay-600">Funnel</p><p class="text-xs text-ink/50 mt-1 mb-4">Where every vendor stands</p>
            <ul>${steps.map(([l, v, sub]) => `<li class="py-2.5 border-b border-hairline last:border-0"><div class="flex items-center justify-between gap-3 text-sm"><span>${l}<span class="block text-[11px] text-ink/45">${sub}</span></span><span class="display text-2xl tabular-nums">${num(v)}</span></div><div class="mt-1.5 h-1 rounded-full bg-parchment overflow-hidden"><div class="h-full bg-clay-500" style="width:${Math.round(100 * (v || 0) / max)}%"></div></div></li>`).join('')}</ul>
          </div>
          <div class="md:col-span-3 rounded-3xl border border-hairline bg-white p-6">
            <p class="eyebrow text-clay-600">Sends Per Week</p><p class="text-xs text-ink/50 mt-1 mb-4">Last 8 weeks, from the outreach log, weeks starting Monday</p>
            <div id="ch-outreach"></div>
            <p class="eyebrow text-clay-600 mt-8 mb-3">Outreach Status Counts</p>
            <table class="w-full text-sm"><tbody>${Object.entries(os).sort((a, b) => b[1] - a[1]).map(([k, v]) => `<tr class="border-t border-hairline"><td class="py-2">${esc(outLabel(k))} <span class="text-ink/40">(${esc(k)})</span></td><td class="py-2 text-right tabular-nums">${num(v)}</td></tr>`).join('')}</tbody></table>
          </div>
        </div>`;
      chart('ch-outreach', (OV.outreach_weekly || []).map(w => ({ d: w.week, views: w.sent })), { h: 200, keys: ['views'], unit: 'emails', every: 1, label: 'Outreach emails sent per week', xlabel: p => fmtDay(p.d) });
    }

    // ---------- events ----------
    document.addEventListener('click', async e => {
      const t = e.target;
      if (t.closest('#aa-submit')) { signIn(); return; }
      if (t.closest('#ad-signout')) { localStorage.removeItem('ceg_admin'); location.reload(); return; }
      if (t.closest('#ad-refresh')) { const b = t.closest('#ad-refresh'); b.textContent = 'Refreshing…'; const ok = await loadAll(); b.textContent = 'Refresh'; if (ok) { paintAll(); setTab(activeTab); } else { localStorage.removeItem('ceg_admin'); location.reload(); } return; }
      if (t.closest('#ad-pwtoggle')) { document.getElementById('ad-pw').classList.toggle('hidden'); return; }
      if (t.closest('#pw-save')) {
        const a = document.getElementById('pw-new').value, b = document.getElementById('pw-confirm').value, msg = document.getElementById('pw-msg');
        if (a.length < 12) { msg.textContent = 'Use at least 12 characters.'; return; }
        if (a !== b) { msg.textContent = 'The two passwords do not match.'; return; }
        msg.textContent = 'Saving…';
        const res = await rpc('ceg_admin_set_password', { p_token: tok(), p_new: a });
        msg.textContent = res && res.ok ? 'Saved ✓' : ((res && res.error) || 'Could not save.');
        if (res && res.ok) { document.getElementById('pw-new').value = ''; document.getElementById('pw-confirm').value = ''; }
        return;
      }
      const tab = t.closest('[data-tab]'); if (tab) { setTab(tab.dataset.tab); return; }
      if (t.closest('#vf-csv')) { exportCsv(); return; }
      const rg = t.closest('[data-range]'); if (rg) { const n = Number(rg.dataset.range); if (n === trDays && TR) return; trDays = n; rg.textContent = 'Loading…'; const r = await rpc('ceg_admin_traffic', { p_token: tok(), p_days: n }); if (r) TR = r; paintTraffic(); setTab('traffic'); return; }
      if (t.closest('#tr-csv')) { exportPagesCsv(); return; }
      if (t.closest('#mk-copy')) { const b = t.closest('#mk-copy'); try { await navigator.clipboard.writeText(mediaKitText()); b.textContent = 'Copied ✓'; } catch (_) { b.textContent = 'Select And Copy'; } setTimeout(() => { b.textContent = 'Copy Text'; }, 2000); return; }
      if (t.closest('#mk-print')) { printMediaKit(); return; }
      const th = t.closest('th[data-sort]'); if (th) { const k = th.dataset.sort; if (sortKey === k) sortDir = -sortDir; else { sortKey = k; sortDir = ['name', 'category', 'sub_region', 'status', 'account_email', 'outreach_status'].includes(k) ? 1 : -1; } paintVendorTable(); return; }
      if (t.closest('[data-stop]')) return;
      const row = t.closest('tr[data-vid]'); if (row) { openDrawer(Number(row.dataset.vid)); return; }
      if (t.closest('#drawer-close') || t.closest('#drawer-bg')) { closeDrawer(); return; }
      const act = t.closest('[data-act]'); if (act) { doStatus(act.dataset.act); return; }
    });
    document.addEventListener('input', e => {
      if (e.target.id === 'vf-q') { clearTimeout(qTimer); qTimer = setTimeout(() => { filters.q = e.target.value; paintVendorTable(); }, 150); }
    });
    document.addEventListener('change', e => {
      if (e.target.id === 'vf-status') { filters.status = e.target.value; paintVendorTable(); }
      if (e.target.id === 'vf-cat') { filters.category = e.target.value; paintVendorTable(); }
      if (e.target.id === 'vf-reg') { filters.region = e.target.value; paintVendorTable(); }
    });
    document.addEventListener('keydown', e => {
      if (e.key === 'Escape' && DRAWER) closeDrawer();
      if (e.key === 'Enter' && (e.target.id === 'aa-email' || e.target.id === 'aa-pass')) signIn();
    });
    document.addEventListener('DOMContentLoaded', boot);
  </script>
</Base>
