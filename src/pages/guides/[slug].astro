---
import Base from '../../layouts/Base.astro';
import EmailCapture from '../../components/EmailCapture.astro';
import { getCollection, render } from 'astro:content';
import { allVendors } from '../../lib/vendors';
import { CATEGORIES, REGIONS } from '../../lib/taxonomy';
import { regionImg } from '../../lib/assets';

export async function getStaticPaths() {
  const guides = await getCollection('guides');
  return guides
    .filter(g => g.data.region in REGIONS && g.data.region !== 'other-colorado')
    .map(g => ({ params: { slug: g.data.region }, props: { guide: g } }));
}

const { guide } = Astro.props;
const { slug } = Astro.params;
const meta = REGIONS[slug];
const { Content, headings } = await render(guide);
const toc = headings.filter(h => h.depth === 2);

const all = await allVendors();
const local = all.filter(v => v.sub_region === slug);
const counts = Object.keys(CATEGORIES).map(c => ({ cat: c, n: local.filter(v => v.category === c).length }));

const others = (await getCollection('guides'))
  .filter(g => g.data.region !== slug && g.data.region in REGIONS && g.data.region !== 'other-colorado')
  .sort((a, b) => Object.keys(REGIONS).indexOf(a.data.region) - Object.keys(REGIONS).indexOf(b.data.region));

// Headline convention: text wrapped in *asterisks* renders in the italic display face.
const headlineParts = guide.data.headline.split('*');

const pageUrl = new URL(`/guides/${slug}/`, Astro.site).href;
const ld = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: guide.data.headline.replace(/\*/g, ''),
  description: guide.data.description,
  datePublished: guide.data.datePublished,
  dateModified: guide.data.dateModified ?? guide.data.datePublished,
  image: regionImg(slug),
  mainEntityOfPage: { '@type': 'WebPage', '@id': pageUrl },
  author: { '@type': 'Organization', name: 'Colorado Elopement Guide', url: 'https://coloradoelopementguide.com' },
  publisher: { '@type': 'Organization', name: 'Colorado Elopement Guide', url: 'https://coloradoelopementguide.com', logo: { '@type': 'ImageObject', url: 'https://coloradoelopementguide.com/favicon.svg' } }
};
const crumbs = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://coloradoelopementguide.com/' },
    { '@type': 'ListItem', position: 2, name: 'Planning Guides', item: 'https://coloradoelopementguide.com/guides/' },
    { '@type': 'ListItem', position: 3, name: meta.name, item: pageUrl }
  ]
};
const published = new Date(guide.data.datePublished + 'T12:00:00Z').toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
---
<Base dark={true} title={guide.data.title} description={guide.data.description}>
  <script is:inline type="application/ld+json" slot="head" set:html={JSON.stringify(ld)} />
  <script is:inline type="application/ld+json" slot="head" set:html={JSON.stringify(crumbs)} />

  <section class="relative min-h-[56vh] flex items-end">
    <img src={regionImg(slug)} alt={meta.name} class="absolute inset-0 w-full h-full object-cover" fetchpriority="high" />
    <div class="absolute inset-0 bg-gradient-to-t from-ink/80 via-ink/25 to-black/30"></div>
    <div class="relative z-10 max-w-7xl mx-auto px-5 md:px-8 pb-12 md:pb-16 w-full">
      <p class="eyebrow text-gold mb-3"><a href="/guides" class="hover:text-ivory">Planning Guides</a> · {meta.name}</p>
      <h1 class="display text-white text-4xl md:text-6xl leading-[1.05] max-w-3xl">
        {headlineParts.map((part, i) => i % 2 === 1 ? <span class="serif-i">{part}</span> : part)}
      </h1>
      <p class="mt-5 max-w-2xl text-white/85 text-[1.02rem] leading-relaxed">{guide.data.dek}</p>
      <p class="mt-4 text-xs text-white/55">Published {published} · Rules and fees change, so confirm with the office linked before you book travel.</p>
    </div>
  </section>

  <section class="border-b border-hairline bg-parchment/60">
    <div class="max-w-7xl mx-auto px-5 md:px-8 py-6 grid grid-cols-2 md:grid-cols-4 gap-6 text-sm">
      <div><p class="eyebrow text-clay-600 mb-1.5">Marriage License</p><p class="text-ink/75 leading-snug">{guide.data.facts.license}</p></div>
      <div><p class="eyebrow text-clay-600 mb-1.5">Ceremony Permits</p><p class="text-ink/75 leading-snug">{guide.data.facts.permit}</p></div>
      <div><p class="eyebrow text-clay-600 mb-1.5">Best Months</p><p class="text-ink/75 leading-snug">{guide.data.facts.season}</p></div>
      <div><p class="eyebrow text-clay-600 mb-1.5">Fly Into</p><p class="text-ink/75 leading-snug">{guide.data.facts.airport}</p></div>
    </div>
  </section>

  <div class="max-w-3xl mx-auto px-5 md:px-8 pt-10">
    <nav aria-label="On this page" class="flex flex-wrap gap-2 text-xs">
      {toc.map(h => <a href={`#${h.slug}`} class="rounded-full border border-hairline bg-white px-3 py-1.5 text-ink/70 hover:border-ink/40 hover:text-ink transition-colors">{h.text}</a>)}
    </nav>
  </div>

  <article class="guide-body max-w-3xl mx-auto px-5 md:px-8 pt-10">
    <Content />
  </article>

  <section class="max-w-3xl mx-auto px-5 md:px-8 pt-12">
    <p class="eyebrow text-clay-600 mb-4">Listed In {meta.name}</p>
    <div class="grid grid-cols-2 md:grid-cols-3 gap-px bg-hairline border border-hairline rounded-2xl overflow-hidden">
      {counts.map(({ cat, n }) => (
        <a href={n > 0 ? `/region/${slug}` : `/category/${cat}`} class="group bg-ivory hover:bg-parchment transition-colors p-5">
          <p class="display text-lg leading-snug group-hover:text-clay-700 transition-colors">{CATEGORIES[cat].name}</p>
          <p class="text-xs text-ink/50 mt-1.5">{n > 0 ? `${n} based here` : 'statewide travelers'}</p>
        </a>
      ))}
    </div>
    <p class="mt-4 text-sm"><a href={`/region/${slug}`} class="font-medium underline underline-offset-4 hover:text-clay-700">See every vendor in {meta.name} →</a></p>
  </section>

  <section class="max-w-3xl mx-auto px-5 md:px-8 pt-14">
    <div class="rounded-3xl bg-spruce-900 text-ivory p-8 md:p-10 md:flex items-center justify-between gap-8">
      <div>
        <p class="eyebrow text-gold mb-3">Your Free Planner</p>
        <h2 class="display text-2xl md:text-3xl leading-tight">Keep the permit, the license dates<br class="hidden md:block" /> and <span class="serif-i">every vendor</span> in one place</h2>
        <p class="text-sm text-ivory/75 mt-3 leading-relaxed max-w-md">Heart the vendors you like as you browse, then track quotes, notes and bookings alongside the Colorado checklist. Free, synced to your email.</p>
      </div>
      <div class="mt-6 md:mt-0 shrink-0"><a href="/account" class="inline-block rounded-full bg-ivory text-ink px-7 py-3.5 text-sm font-semibold hover:bg-white transition-colors">Start My Planner</a></div>
    </div>
  </section>

  <section class="max-w-7xl mx-auto px-5 md:px-8 pt-20">
    <p class="eyebrow text-clay-600 mb-3">More Planning Guides</p>
    <h2 class="display text-3xl leading-tight mb-8">Another corner <span class="serif-i">of Colorado</span></h2>
    <div class="grid grid-cols-2 md:grid-cols-4 gap-3 md:gap-4">
      {others.map(g => (
        <a href={`/guides/${g.data.region}`} class="img-tile group relative rounded-2xl overflow-hidden h-44 md:h-52">
          <img src={regionImg(g.data.region)} alt={REGIONS[g.data.region].name} loading="lazy" class="absolute inset-0 w-full h-full object-cover" />
          <div class="absolute inset-0 bg-gradient-to-t from-ink/75 via-transparent to-transparent"></div>
          <div class="absolute bottom-0 p-4">
            <p class="display text-ivory text-lg leading-tight">{REGIONS[g.data.region].name}</p>
            <p class="text-[11px] text-ivory/70 mt-1">Read the guide →</p>
          </div>
        </a>
      ))}
    </div>
  </section>

  <div class="max-w-7xl mx-auto px-5 md:px-8 pt-20"><EmailCapture /></div>
</Base>

<style is:global>
  .guide-body h2 { font-family: var(--font-display); font-weight: 400; letter-spacing: -0.01em; font-size: 1.85rem; line-height: 1.2; margin: 3rem 0 1rem; scroll-margin-top: 1.5rem; }
  .guide-body h2:first-child { margin-top: 0; }
  .guide-body h3 { font-family: var(--font-display); font-weight: 400; font-size: 1.3rem; line-height: 1.3; margin: 2rem 0 0.5rem; }
  .guide-body p { color: rgb(35 40 31 / 0.78); font-size: 1.02rem; line-height: 1.8; margin: 0 0 1.15rem; }
  .guide-body > p:first-of-type { font-size: 1.12rem; color: rgb(35 40 31 / 0.88); }
  .guide-body a { text-decoration: underline; text-underline-offset: 4px; text-decoration-color: var(--color-gold); color: var(--color-ink); }
  .guide-body a:hover { color: var(--color-clay-700); }
  .guide-body strong { color: var(--color-ink); font-weight: 600; }
  .guide-body em { font-family: var(--font-display); font-style: italic; font-size: 1.05em; }
  .guide-body ul, .guide-body ol { margin: 0 0 1.25rem 1.3rem; color: rgb(35 40 31 / 0.78); line-height: 1.7; }
  .guide-body ul { list-style: disc; }
  .guide-body ol { list-style: decimal; }
  .guide-body li { margin-bottom: 0.4rem; padding-left: 0.2rem; }
  .guide-body li::marker { color: var(--color-clay-500); }
  .guide-body blockquote { border-left: 2px solid var(--color-gold); margin: 1.5rem 0; padding: 0.25rem 0 0.25rem 1.25rem; }
  .guide-body blockquote p { font-family: var(--font-display); font-style: italic; font-size: 1.2rem; color: var(--color-ink); }
  .guide-body hr { border: 0; border-top: 1px solid var(--color-hairline); margin: 2.5rem 0; }
</style>
