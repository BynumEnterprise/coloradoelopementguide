---
import { CATEGORIES, REGIONS } from '../lib/taxonomy';
const { v } = Astro.props;
const featured = v.status === 'featured';
---
<a href={`/vendor/${v.slug}`} class={`block rounded-xl border bg-white p-5 hover:shadow-md transition-shadow ${featured ? 'border-clay-500 ring-1 ring-clay-500' : 'border-stone-200'}`}>
  {featured && <span class="inline-block text-[11px] uppercase tracking-wide bg-clay-100 text-clay-700 rounded px-2 py-0.5 mb-2">Featured</span>}
  <div class="flex items-start justify-between gap-3">
    <div>
      <h3 class="font-semibold text-pine-900 leading-snug">{v.name}</h3>
      <p class="text-xs text-stone-500 mt-0.5">{CATEGORIES[v.category]?.singular} · {REGIONS[v.sub_region]?.name}</p>
    </div>
    {v.rating && v.reviews ? <p class="text-sm shrink-0 text-pine-700 font-medium">★ {v.rating} <span class="text-stone-400">({v.reviews})</span></p> : null}
  </div>
  <p class="text-sm text-stone-600 mt-2 line-clamp-2">{v.description}</p>
</a>
