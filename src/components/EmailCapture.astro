---
import { IMG } from '../lib/assets';
---
<div class="rounded-3xl overflow-hidden md:grid md:grid-cols-2 bg-spruce-900 text-ivory">
  <div class="hidden md:block relative min-h-[280px]">
    <img src={`${IMG}/checklist.jpg`} alt="Wedding planning flat lay with rings and vows" class="absolute inset-0 w-full h-full object-cover" loading="lazy" />
  </div>
  <div class="p-8 md:p-12">
    <p class="eyebrow text-gold mb-3">Free planning resource</p>
    <h3 class="display text-2xl md:text-[1.7rem] leading-tight mb-2">The Colorado Elopement <span class="serif-i">Checklist</span></h3>
    <p class="text-sm text-ivory/75 mb-6 leading-relaxed">Licenses, self-solemnization, permits for RMNP and beyond, and what to book first. <a href="/checklist" class="underline hover:text-ivory">Read it now</a> — or get it in your inbox.</p>
    <form method="post" action="/api/subscribe" class="flex flex-wrap gap-2.5" data-subscribe>
      <input type="email" name="email" required placeholder="you@example.com"
        class="flex-1 min-w-[210px] rounded-full px-5 py-3 text-ink text-sm bg-ivory placeholder-ink/40 outline-none focus:ring-2 focus:ring-gold" />
      <button class="rounded-full bg-clay-500 hover:bg-clay-600 px-6 py-3 text-sm font-medium transition-colors">Send it to me</button>
    </form>
    <p class="text-[11px] text-ivory/45 mt-3">One email with the checklist, then occasional planning notes. Unsubscribe anytime.</p>
  </div>
</div>
